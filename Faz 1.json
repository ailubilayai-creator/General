<script>
/* ============ GLOBAL HATA YAKALAYICI ============ */
window.addEventListener('error', e => {
  console.error('GLOBAL:', e.message, e.lineno);
  const k = document.getElementById('konsol');
  if (k) { const d = document.createElement('div'); d.className='hata'; d.textContent=`💥 ${e.message} @ ${e.lineno}`; k.appendChild(d); }
});
window.addEventListener('unhandledrejection', e => {
  console.error('PROMISE:', e.reason);
  const k = document.getElementById('konsol');
