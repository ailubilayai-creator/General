function clip(x,lo=-1,hi=1){return Math.max(lo,Math.min(hi,x));}

/* ============ GÖSTERGELER ============ */
function emaSeries(closes,p){
  const out=new Array(closes.length).fill(null);
  if(closes.length<p) return out;
  const k=2/(p+1); let e=closes.slice(0,p).reduce((a,b)=>a+b,0)/p; out[p-1]=e;
  for(let i=p;i<closes.length;i++){e=closes[i]*k+e*(1-k); out[i]=e;}
  return out;
}
function rsiSeries(closes,p=14){
  const out=new Array(closes.length).fill(null);
  if(closes.length<p+1) return out;
  let g=0,l=0;
  for(let i=1;i<=p;i++){const d=closes[i]-closes[i-1]; if(d>=0) g+=d; else l-=d;}
  let ag=g/p,al=l/p;
  out[p]=al===0?100:100-100/(1+ag/al);
  for(let i=p+1;i<closes.length;i++){
    const d=closes[i]-closes[i-1];
    ag=(ag*(p-1)+Math.max(d,0))/p; al=(al*(p-1)+Math.max(-d,0))/p;
    out[i]=al===0?100:100-100/(1+ag/al);
  }
  return out;
}
function atrSeries(klines,p=14){
  const out=new Array(klines.length).fill(null);
  if(klines.length<p+1) return out;
  let atr=null;
  for(let i=1;i<klines.length;i++){
    const h=klines[i].high,l=klines[i].low,pc=klines[i-1].close;
    const tr=Math.max(h-l,Math.abs(h-pc),Math.abs(l-pc));
    if(i===p){let sum=0; for(let j=1;j<=p;j++){const hh=klines[j].high,ll=klines[j].low,pc2=klines[j-1].close; sum+=Math.max(hh-ll,Math.abs(hh-pc2),Math.abs(ll-pc2));} atr=sum/p; out[i]=atr;}
    else if(i>p){atr=(atr*(p-1)+tr)/p; out[i]=atr;}
  }
  return out;
}
function seriesAl(sym){
  const s=state.symbols[sym],k=s.klines;
  if(k.length<60) return null;
  const key=klineHash(k);
  if(s._seriesCacheKey===key && s._seriesCache) return s._seriesCache;
  const closes=k.map(x=>x.close);
  const cache={closes,rsi:rsiSeries(closes,14),atr:atrSeries(k,14),ema20:emaSeries(closes,20),ema50:emaSeries(closes,50),emaKisa:{},emaUzun:{}};
  for(const p of [10,15,20,25,30]) cache.emaKisa[p]=emaSeries(closes,p);
  for(const p of [40,50,60,80,100]) cache.emaUzun[p]=emaSeries(closes,p);
  s._seriesCache=cache; s._seriesCacheKey=key; return cache;
}

