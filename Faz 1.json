/* ============ AI MLP ============ */
const AI_KEY='bot_ai_v2';
class MLP{
  constructor(nIn=FEATURES,nHid=HIDDEN){
    this.nIn=nIn; this.nHid=nHid;
    const rnd=()=>(Math.random()-0.5)*2;
    this.W1=Array.from({length:nHid},()=>Array.from({length:nIn},()=>rnd()*Math.sqrt(2/nIn)));
    this.b1=new Array(nHid).fill(0);
    this.W2=Array.from({length:nHid},()=>rnd()*Math.sqrt(2/nHid));
    this.b2=0; this.lr=0.03; this.egitimSayisi=0; this.dogruTahmin=0; this.toplamTest=0;
  }
  forward(x){
    const h=new Array(this.nHid);
    for(let i=0;i<this.nHid;i++){let s=this.b1[i]; for(let j=0;j<this.nIn;j++) s+=this.W1[i][j]*x[j]; h[i]=Math.tanh(s);}
    let o=this.b2; for(let i=0;i<this.nHid;i++) o+=this.W2[i]*h[i];
    o=1/(1+Math.exp(-Math.max(-30,Math.min(30,o))));
    return {h,o};
  }
  train(x,y){
    const {h,o}=this.forward(x);
    const dOut=2*(o-y)*o*(1-o);
    const dH=new Array(this.nHid);
    for(let i=0;i<this.nHid;i++) dH[i]=dOut*this.W2[i]*(1-h[i]*h[i]);
    for(let i=0;i<this.nHid;i++){this.W2[i]-=this.lr*dOut*h[i]; for(let j=0;j<this.nIn;j++) this.W1[i][j]-=this.lr*dH[i]*x[j]; this.b1[i]-=this.lr*dH[i];}
    this.b2-=this.lr*dOut; this.egitimSayisi++;
  }
  predict(x){return this.forward(x).o;}
  serialize(){return {W1:this.W1,b1:this.b1,W2:this.W2,b2:this.b2,egitimSayisi:this.egitimSayisi,dogruTahmin:this.dogruTahmin,toplamTest:this.toplamTest};}
  load(d){if(!d) return; Object.assign(this,d);}
}
function datasetAl(sym){
  const s=state.symbols[sym],k=s.klines;
  if(k.length<60) return null;
  const key=klineHash(k);
  if(s._datasetCacheKey===key&&s._datasetCache) return s._datasetCache;
  const series=seriesAl(sym); if(!series) return null;
  const closes=series.closes,ornekler=[];
  for(let i=60;i<k.length;i++){
    const cur=closes[i]; if(!cur||!closes[i-1]) continue;
    const f=[];
    for(let j=1;j<=5;j++){const p1=closes[i-j],p0=closes[i-j-1]??p1; f.push(clip((p1-p0)/p0*50));}
    f.push(((series.rsi[i]??50)-50)/50);
    f.push(clip((series.atr[i]??0)/cur*100/5,0,1));
    f.push(clip(((series.ema20[i]??cur)-(series.ema50[i]??cur))/cur*10));
    const v5=k.slice(Math.max(0,i-4),i+1).reduce((a,x)=>a+x.volume,0)/Math.min(5,i+1);
    const v20=k.slice(Math.max(0,i-19),i+1).reduce((a,x)=>a+x.volume,0)/Math.min(20,i+1)+1e-9;
    f.push(clip(v5/v20-1));
    ornekler.push({x:f,y:cur>closes[i-1]?1:0});
  }
  s._datasetCache=ornekler; s._datasetCacheKey=key; return ornekler;
}
function aiEgit(sym,epochs=3){
  const s=state.symbols[sym];
  if(!s.mlp) s.mlp=new MLP();
  const ornekler=datasetAl(sym);
  if(!ornekler||ornekler.length<20) return;
  const sonN=ornekler.slice(-150);
  for(let ep=0;ep<epochs;ep++) for(const o of sonN) s.mlp.train(o.x,o.y);
}
function ozellikCikar(sym){
  const s=state.symbols[sym],k=s.klines;
  if(k.length<60) return null;
  const series=seriesAl(sym); if(!series) return null;
  const closes=series.closes,cur=closes[closes.length-1];
  const f=[];
  for(let i=1;i<=5;i++){const p1=closes[closes.length-i],p0=closes[closes.length-i-1]; f.push(clip((p1-p0)/p0*50));}
  f.push(((series.rsi[series.rsi.length-1]??50)-50)/50);
  f.push(clip((series.atr[series.atr.length-1]??0)/cur*100/5,0,1));
  f.push(clip(((series.ema20[series.ema20.length-1]??cur)-(series.ema50[series.ema50.length-1]??cur))/cur*10));
  const v5=k.slice(-5).reduce((a,x)=>a+x.volume,0)/5;
  const v20=k.slice(-20).reduce((a,x)=>a+x.volume,0)/20+1e-9;
  f.push(clip(v5/v20-1));
  return f;
}
async function aiEgitTumSemboller(){
  logYaz('🎓 AI eğitimi başlatılıyor...','ai');
  for(const sym of SYMBOLS){
    if(!state.symbols[sym].klines.length){try{state.symbols[sym].klines=await klinesCek(sym,200,'1m');}catch(e){}}
    if(!state.symbols[sym].mlp) state.symbols[sym].mlp=new MLP();
    aiEgit(sym,45);
