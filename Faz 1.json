function gosterVotePanel(sym,vote){
  const aAdi=['Atla','0.5x','1.0x','2.0x'];
  const sec=aAdi[vote.action];
  const html=`
    <div style="color:#fde68a;font-weight:bold">🗳️ Son Oylama [${S_INFO[sym].short}]: → <span style="color:#10b981">${sec}</span> (${vote.agree}/${vote.votes.length} uyum, güven ${(vote.conf*100).toFixed(0)}%)</div>
    <div class="vote-row">
      ${vote.votes.map(v=>{
        const win=v.action===vote.action?'win':'lose';
        const oy=aAdi[v.action];
        return `<div class="vote-item ${win}"><b>${v.model}</b> → ${oy} <span style="opacity:0.7">(w=${v.w.toFixed(2)})</span></div>`;
      }).join('')}
    </div>
  `;
  els.votePanel.innerHTML=html;
}
function mtfPaneliGuncelle(){
  const p=els.mtfPanel; if(!p) return;
  let html='<div class="mtf-row" style="font-weight:bold;color:#7dd3fc"><div class="mtf-label">TF</div><div>RSI</div><div>Trend</div><div>ATR%</div></div>';
  for(const sym of SYMBOLS){
    const s=state.symbols[sym];
    const name=S_INFO[sym].short;
    const getVals=(kl)=>{
      if(!kl||kl.length<60) return {rsi:'-',tr:'-',atr:'-'};
      const f=timeframeFeatures(kl);
      if(!f) return {rsi:'-',tr:'-',atr:'-'};
      return {rsi:((f[0]+0.5)*100).toFixed(1), tr:(f[1]*100).toFixed(1)+'%', atr:(f[2]*100).toFixed(2)+'%'};
    };
    const v1=getVals(s.klines),v5=getVals(s.klines5m),v15=getVals(s.klines15m);
    html+=`
      <div class="mtf-row"><div class="mtf-label" style="color:${S_INFO[sym].color}">${name} 1m</div><div class="mtf-cell">${v1.rsi}</div><div class="mtf-cell">${v1.tr}</div><div class="mtf-cell">${v1.atr}</div></div>
      <div class="mtf-row"><div class="mtf-label" style="color:${S_INFO[sym].color}">${name} 5m</div><div class="mtf-cell">${v5.rsi}</div><div class="mtf-cell">${v5.tr}</div><div class="mtf-cell">${v5.atr}</div></div>
      <div class="mtf-row"><div class="mtf-label" style="color:${S_INFO[sym].color}">${name} 15m</div><div class="mtf-cell">${v15.rsi}</div><div class="mtf-cell">${v15.tr}</div><div class="mtf-cell">${v15.atr}</div></div>
    `;
  }
  p.innerHTML=html;
}

function guncelleUI(){
  const setT=(el,v)=>{if(el) el.textContent=v;};
  const setC=(el,c)=>{if(el) el.className=c;};
  for(const sym of SYMBOLS){
    const s=state.symbols[sym],info=S_INFO[sym],id=info.short;
    const fiyat=s.ticker.fiyat||(s.klines.length?s.klines[s.klines.length-1].close:0);
    setT(document.getElementById('price-'+id),fiyat?'$'+fmt(fiyat,fiyat>100?2:4):'-');
    setT(document.getElementById('rsi-'+id),s.indicators.rsi?.toFixed(1)??'-');
    setT(document.getElementById('atr-'+id),s.indicators.atr&&fiyat?((s.indicators.atr/fiyat)*100).toFixed(2)+'%':'-');
    setT(document.getElementById('ema-'+id),s.indicators.ema20?'$'+fmt(s.indicators.ema20,0):'-');
    setT(document.getElementById('ai-'+id),s.aiTahmin!=null?(s.aiTahmin>0.5?'↑':'↓')+(Math.max(s.aiTahmin,1-s.aiTahmin)*100).toFixed(0)+'%':'-');
    const pos=document.getElementById('pos-'+id);
    if(pos){
      if(s.position){pos.textContent=s.position.yon+' '+(s.position.yon==='AL'?'LONG':'SHORT'); pos.className='symbol-pos '+(s.position.yon==='AL'?'long':'short');}
      else{pos.textContent='pozisyon yok'; pos.className='symbol-pos';}
    }
    const kar=document.getElementById('karar-'+id);
    if(kar){
      kar.textContent=s.sonKarar;
      kar.className='symbol-karar '+(s.sonKarar==='AL'?'k-al':s.sonKarar==='SAT'?'k-sat':'k-bekle');
    }
  }
  const toplam=toplamBakiye();
  const karD=toplam-state.portfolio.baslangic;
  const karY=(karD/state.portfolio.baslangic)*100;
  setT(els.statBakiye,fmtDolar(toplam));
  setC(els.statBakiye,'stat-value '+(karD>=0?'pos':'neg'));
  setT(els.statBakiyeSub,`Nakit: $${fmt(state.portfolio.bakiye)}`);
  setT(els.statKarDolar,(karD>=0?'+':'')+fmtDolar(karD));
  setC(els.statKarDolar,'stat-value '+(karD>=0?'pos':'neg'));
  setT(els.statKar,(karY>=0?'+':'')+karY.toFixed(2)+'%');
  setC(els.statKar,'stat-value '+(karY>=0?'pos':'neg'));
  setT(els.statToplamIslem,state.portfolio.toplamIslem);
  setT(els.statToplamIslem2,state.portfolio.toplamIslem);
  setT(els.statToplamKar,`kar $${fmt(state.portfolio.toplamKar)}`);
  setT(els.statBekleyen,bekleyenIslemSayisi());
  setT(els.statWK,`${state.portfolio.kazanan} / ${state.portfolio.kaybeden}`);
  const wr=(state.portfolio.kazanan+state.portfolio.kaybeden)>0?(state.portfolio.kazanan/(state.portfolio.kazanan+state.portfolio.kaybeden)*100).toFixed(1)+'%':'-';
  setT(els.statWROran,`Kazanma: ${wr}`);
  const btc=state.symbols.BTCUSDT;
  if(btc.aiTahmin!=null){
    setT(els.statAiTahmin,btc.aiTahmin>0.5?'↑ AL':'↓ SAT');
    setC(els.statAiTahmin,'stat-value ai '+(btc.aiTahmin>0.5?'pos':'neg'));
    setT(els.statAiConf,`güven ${(Math.max(btc.aiTahmin,1-btc.aiTahmin)*100).toFixed(0)}%`);
  } else {setT(els.statAiTahmin,'-'); setT(els.statAiConf,'güven -');}
  const qs=qlearning.istatistik();
  setT(els.statQAdim,qs.egitim);
  setT(els.statQState,`${qs.states} state`);
  let dqnAdim=0,dqnBuf=0,dqnEps=1.0,dqnLoss=0,dqnSay=0;
  for(const sym of SYMBOLS){const d=state.symbols[sym].dqn; if(d){dqnAdim+=d.egitimSayaci; dqnBuf+=d.replayBuffer.length; dqnEps=Math.min(dqnEps,d.epsilon); dqnLoss+=d.sonLoss; dqnSay++;}}
  setT(els.statDqnAdim,dqnAdim); setT(els.statDqnBuffer,`buffer ${dqnBuf}`);
  setT(els.statDqnEps,dqnEps.toFixed(3));
  setT(els.statDqnLossSub,dqnSay?`loss ${(dqnLoss/dqnSay).toFixed(3)}`:'loss -');
  setT(els.dqnDurum,`DQN: ${dqnAdim}`);
  setC(els.dqnDurum,'status-item '+(dqnAdim>0?'dqn':''));
  let pgEp=0,pgR=0,pgSay=0;
  for(const sym of SYMBOLS){const p=state.symbols[sym].pg; if(p){pgEp+=p.episodeSayaci; pgR+=p.toplamReward/Math.max(1,p.episodeSayaci); pgSay++;}}
  setT(els.statPgEp,pgEp); setT(els.statPgReward,`ort. ${pgSay?(pgR/pgSay).toFixed(2):'0'}`);
  let ppoEp=0,ppoLoss=0,ppoClip=0,ppoH=0,ppoSay=0;
  for(const sym of SYMBOLS){const p=state.symbols[sym].ppo; if(p){ppoEp+=p.episodeSayaci; ppoLoss+=p.sonLoss; ppoClip+=p.sonClipFrac; ppoH+=p.sonEntropi; ppoSay++;}}
  setT(els.statPpoEp,ppoEp); setT(els.statPpoLoss,ppoSay?`loss ${(ppoLoss/ppoSay).toFixed(3)}`:'loss -');
  setT(els.statPpoClip,ppoSay?(ppoClip/ppoSay*100).toFixed(1)+'%':'-');
  setT(els.statPpoEntropy,ppoSay?`H ${(ppoH/ppoSay).toFixed(3)}`:'H -');
  setT(els.ppoDurum,`PPO: ${ppoEp}`);
  setC(els.ppoDurum,'status-item '+(ppoEp>0?'ppo':''));
  let a2cEp=0,a2cLoss=0,a2cAdv=0,a2cH=0,a2cSay=0;
  for(const sym of SYMBOLS){const a=state.symbols[sym].a2c; if(a){a2cEp+=a.episodeSayaci; a2cLoss+=a.sonLoss; a2cAdv+=a.sonAdv; a2cH+=a.sonEntropi; a2cSay++;}}
  setT(els.statA2cEp,a2cEp); setT(els.statA2cLoss,a2cSay?`loss ${(a2cLoss/a2cSay).toFixed(2)}`:'loss -');
  setT(els.statA2cAdv,a2cSay?(a2cAdv/a2cSay).toFixed(2):'-');
  setT(els.statA2cEntropy,a2cSay?`H ${(a2cH/a2cSay).toFixed(3)}`:'H -');
  setT(els.a2cDurum,`A2C: ${a2cEp}`);
  setC(els.a2cDurum,'status-item '+(a2cEp>0?'a2c':''));
  let trfEp=0,trfLoss=0,trfSay=0;
  for(const sym of SYMBOLS){const t=state.symbols[sym].transformer; if(t){trfEp+=t.episodeSayaci; trfLoss+=t.sonLoss; trfSay++;}}
  setT(els.statTrfEp,trfEp); setT(els.statTrfLoss,trfSay?`loss ${(trfLoss/trfSay).toFixed(3)}`:'loss -');
  setT(els.transDurum,`TRF: ${trfEp}`);
  setC(els.transDurum,'status-item '+(trfEp>0?'trans':''));
  let mamlAd=0,mamlLoss=0,mamlSay=0;
  for(const sym of SYMBOLS){const m=state.symbols[sym].maml; if(m&&m.egitimSayaci>0){mamlAd+=m.egitimSayaci; mamlLoss+=m.sonAdaptLoss; mamlSay++;}}
  setT(els.statMamlAd,mamlAd);
  setT(els.statMamlInfo,mamlSay?`inner: ${(mamlLoss/mamlSay).toFixed(3)}`:'inner: -');
  setT(els.mamlDurum,`MAML: ${mamlAd}`);
  setC(els.mamlDurum,'status-item '+(mamlAd>0?'maml':''));
  const mtf=mtfStateCikar('BTCUSDT');
  setT(els.statMtfDim,mtf?mtf.length+'-dim':'-');
  setT(els.mtfDurum,`MTF: ${mtf?'✓':'-'}`);
  setC(els.mtfDurum,'status-item '+(mtf?'mtf':''));
  const ens=ensemble.istatistik();
  setT(els.statEnsWR,ens.toplamOylama>0
    ?`${ens.q.w}K/${ens.q.l}Z · ${ens.dqn.w}K/${ens.dqn.l}Z · ${ens.ppo.w}K/${ens.ppo.l}Z · ${ens.a2c.w}K/${ens.a2c.l}Z`
    :'-');
  setT(els.statEnsVote,`oylama ${ens.toplamOylama}`);
  setT(els.statEnIyi,ens.toplamOylama>0?`${ens.enIyi} (${(ens.enIyiWR*100).toFixed(0)}%)`:'-');
  setT(els.statEnsWeights,`Q=${ens.q.wr.toFixed(2)} DQN=${ens.dqn.wr.toFixed(2)} PPO=${ens.ppo.wr.toFixed(2)} A2C=${ens.a2c.wr.toFixed(2)} TRF=${ens.trf.wr.toFixed(2)} MAML=${ens.maml.wr.toFixed(2)}`);
  setT(els.ensDurum,`ENS: ${ens.toplamOylama} oy`);
  setC(els.ensDurum,'status-item '+(ens.toplamOylama>0?'ens':''));
  const mas=multiAgent.istatistik();
  const kons=multiAgent.konsensus();
  setT(els.statMaShared,mas.paylasim);
  setT(els.statMaKonsensus,`konsensüs: ${kons.detay}`);
  setT(els.statFitnes,genetik.enIyi?genetik.enIyi.fitnes.toFixed(2):'-');
  setT(els.statFitnesSub,genetik.enIyi?`RSI ${genetik.enIyi.rsiAl}/${genetik.enIyi.rsiSat}`:'genetik');
  setT(els.veriDurum,`Veri: ${state.veriSayisi}`);
  setT(els.donguDurum,`Döngü: ${state.donguSayaci}`);
  const mAdi=aktifModel==='dqn'?'DQN':aktifModel==='ppo'?'PPO':aktifModel==='a2c'?'A2C':aktifModel==='transformer'?'Transformer':aktifModel==='maml'?'MAML':aktifModel==='policy'?'PG':aktifModel==='ensemble'?"Ensemble 6'lı":'Q-Table';
  setT(els.modelDurum,`Model: ${mAdi}`);
  setC(els.modelDurum,'status-item '+(aktifModel==='dqn'?'dqn':aktifModel==='ppo'?'ppo':aktifModel==='a2c'?'a2c':aktifModel==='transformer'?'trans':aktifModel==='maml'?'maml':aktifModel==='policy'?'pg':aktifModel==='ensemble'?'ens':'q'));
  mtfPaneliGuncelle();
  guncellePipelineUI();
}

/* ============ MODEL SEÇİCİ ============ */
function modelSec(model){
  if(state.running){logYaz('⚠️ Bot çalışırken model değiştirilemez.','uyari'); return;}
  aktifModel=model;
  els.modeQTable.classList.toggle('aktif',model==='qtable');
  els.modeDQN.classList.toggle('aktif',model==='dqn');
  els.modePG.classList.toggle('aktif',model==='policy');
  els.modePPO.classList.toggle('aktif',model==='ppo');
  els.modeA2C.classList.toggle('aktif',model==='a2c');
  els.modeTRF.classList.toggle('aktif',model==='transformer');
  els.modeMAML.classList.toggle('aktif',model==='maml');
  els.modeENS.classList.toggle('aktif',model==='ensemble');
  const mAdi=model==='dqn'?'DQN+PER':model==='ppo'?'PPO':model==='a2c'?'A2C':model==='transformer'?'Transformer':model==='maml'?'MAML':model==='policy'?'PG':model==='ensemble'?"Ensemble 6'lı (Q+DQN+PPO+A2C+TRF+MAML)":'Q-Table';
  const cls=model==='dqn'?'dqn':model==='ppo'?'ppo':model==='a2c'?'a2c':model==='transformer'?'trans':model==='maml'?'maml':model==='ensemble'?'ens':model==='policy'?'pg':'q';
  logYaz(`🎛️ Aktif RL modeli: ${mAdi}`,cls);
  guncelleUI();
}

/* ============ ANA DÖNGÜ ============ */
async function botDongusu(){
  state.donguSayisi++;
  const WS_AKTIF=state.wsAktif===SYMBOLS.length;
  for(const sym of SYMBOLS){
    const s=state.symbols[sym];
    try{
      if(!WS_AKTIF||s.klines.length<60){
        s.klines=await klinesCek(sym,150,'1m');
      }
      try{s.orderbook=await orderbookCek(sym,100);}catch(e){}
      // MTF: her 5 döngüde bir yenile (yavaş)
      if(state.donguSayisi%5===1 || !s.klines5m||s.klines5m.length<60){
        try{
          const [k5,k15]=await Promise.all([klinesCek(sym,100,'5m'),klinesCek(sym,100,'15m')]);
          s.klines5m=k5; s.klines15m=k15;
        }catch(e){}
      }
      const series=seriesAl(sym);
      if(!series) continue;
      const closes=series.closes;
      s.indicators.rsi=series.rsi[series.rsi.length-1];
      s.indicators.atr=series.atr[series.atr.length-1];
      s.indicators.ema20=series.ema20[series.ema20.length-1];
      s.indicators.ema50=series.ema50[series.ema50.length-1];
      const sonF=closes[closes.length-1];
      if(s.ticker.fiyat===0) s.ticker.fiyat=sonF;
      const guncel=s.ticker.fiyat||sonF;
      if(!s.mlp) s.mlp=new MLP();
      const lastKlineTime=s.klines[s.klines.length-1].time;
      if(s._sonEgitimKline!==lastKlineTime){aiEgit(sym,2); s._sonEgitimKline=lastKlineTime;}
      const ozellik=ozellikCikar(sym);
      if(ozellik){
        const tahmin=s.mlp.predict(ozellik);
        if(s._oncekiTahmin!=null&&s._oncekiTahminKey!=null&&s._oncekiTahminFiyat>0){
          const gercekYon=sonF>s._oncekiTahminFiyat?1:0;
          const tahminYon=s._oncekiTahmin>0.5?1:0;
          s.mlp.toplamTest++;
          if(tahminYon===gercekYon) s.mlp.dogruTahmin++;
        }
        s._oncekiTahmin=tahmin; s._oncekiTahminKey=lastKlineTime; s._oncekiTahminFiyat=sonF;
        s.aiTahmin=tahmin; s.aiConf=Math.abs(tahmin-0.5)*2;
      }
      pozisyonKontrol(sym,guncel);
      const karar=kararMotoru(sym,{fiyat:guncel,rsi:s.indicators.rsi,atr:s.indicators.atr,orderbook:s.orderbook});
      s.sonKarar=karar.karar;
      if(karar.karar==='AL'&&!s.position) pozisyonAc(sym,'AL',guncel,karar.sebep,karar.aktifFiltreler);
      else if(karar.karar==='SAT'&&s.position&&s.position.yon==='AL') pozisyonKapat(sym,guncel,'SAT sinyali');
      else if(karar.karar==='SAT'&&!s.position) pozisyonAc(sym,'SAT',guncel,karar.sebep,karar.aktifFiltreler);
      else if(karar.karar==='AL'&&s.position&&s.position.yon==='SAT') pozisyonKapat(sym,guncel,'AL sinyali');
      const aiStr=s.aiTahmin!=null?` AI:${(s.aiTahmin*100).toFixed(0)}%`:'';
      logYaz(`[${S_INFO[sym].short}] #${state.donguSayisi} $${fmt(guncel,guncel>100?2:4)} RSI:${s.indicators.rsi?.toFixed(1)??'-'}${aiStr} → ${karar.karar} (${karar.sebep})`,
        karar.karar==='AL'?'trade-buy':karar.karar==='SAT'?'trade-sell':'bilgi');
    }catch(e){logYaz(`[${S_INFO[sym].short}] hata: ${e.message}`,'hata');}
  }
  if(state.donguSayisi%5===0){aiKaydet(); dqnKaydet(); pgKaydet(); ppoKaydet(); a2cKaydet(); trfKaydet(); mamlKaydet(); ensemble.kaydet();}
  guncelleUI();
}

/* ============ BAŞLAT / DURDUR ============ */
async function botuBaslat(){
  if(state.running) return;
  state.running=true;
  els.baslatBtn.disabled=true;
  els.baslatBtn.textContent='⏳ Başlatılıyor...';
  els.konsol.innerHTML='';
  logYaz('━━━ BOT v8.0 BAŞLATILIYOR ━━━','basari');
  logYaz(`   Aktif RL modeli: ${aktifModel.toUpperCase()}`,aktifModel==='ensemble'?'ens':aktifModel);
  ogrenme.yukle(); genetik.yukle(); aiYukle(); qlearning.yukle();
  dqnYukle(); pgYukle(); ppoYukle(); a2cYukle(); trfYukle(); mamlYukle(); ensemble.yukle();
  try{
    await configYukle();
    await Promise.all(SYMBOLS.map(async sym=>{
      await mtfYukle(sym);
      try{state.symbols[sym].orderbook=await orderbookCek(sym,100);}catch(e){}
    }));
    logYaz(`✓ ${SYMBOLS.length} sembol + MTF yüklendi.`,'basari');
    await Promise.all(SYMBOLS.map(async sym=>{try{await wsBaslat(sym);}catch(e){}}));
    await botDongusu();
    state.loopTimer=setInterval(botDongusu,15000);
    els.baslatBtn.textContent='⏹ DURDUR';
    els.baslatBtn.disabled=false;
    els.baslatBtn.className='stop';
    logYaz('━━━ BOT AKTİF ━━━','basari');
  }catch(e){
    logYaz('BAŞLATMA HATASI: '+e.message,'hata');
    state.running=false;
    els.baslatBtn.disabled=false;
    els.baslatBtn.textContent='▶ BAŞLAT';
  }
}
function botuDurdur(){
  durdurOtoYenileme();
  state.running=false;
  if(state.loopTimer) clearInterval(state.loopTimer);
  for(const sym of SYMBOLS){const s=state.symbols[sym]; if(s.ws){try{s.ws.close();}catch(e){} s.ws=null;}}
  state.wsAktif=0; updateWsDurum();
  aiKaydet(); qlearning.kaydet(); dqnKaydet(); pgKaydet(); ppoKaydet(); a2cKaydet(); trfKaydet(); mamlKaydet(); ensemble.kaydet();
  els.baslatBtn.textContent='▶ BAŞLAT';
  els.baslatBtn.className='';
  els.baslatBtn.disabled=false;
  logYaz('━━━ BOT DURDURULDU ━━━','uyari');
}

/* ============ SIFIRLAMA & RAPOR ============ */
function hafizaSifirla(){
  if(!confirm("TÜM hafızalar sıfırlanacak (AI+Q+Gen+PG+DQN+PPO+A2C+Transformer+MAML+Ensemble+MA). Emin misin?")) return;
  ogrenme.sifirla();
  genetik.enIyi=null; genetik.nesil=0; genetik.populasyon=[];
  try{localStorage.removeItem(GENETIC_KEY);}catch(e){}
  for(const sym of SYMBOLS){
    const s=state.symbols[sym];
    s.mlp=new MLP(); s.dqn=null; s.pg=null; s.ppo=null; s.a2c=null; s.transformer=null; s.maml=null; s.ensembleVote=null;
  }
  try{
    localStorage.removeItem(AI_KEY); localStorage.removeItem(DQN_KEY); localStorage.removeItem(PG_KEY);
    localStorage.removeItem(PPO_KEY); localStorage.removeItem(A2C_KEY); localStorage.removeItem(TRF_KEY);
    localStorage.removeItem(MAML_KEY);
  }catch(e){}
  qlearning.sifirla();
  multiAgent.sharedBuffer=[]; multiAgent.syncSayaci=0; multiAgent.konsensusSayaci=0;
  ensemble.sifirla();
  pipeline.sifirla();
  els.votePanel.innerHTML='<div style="color:#6b7280">Sıfırlandı.</div>';
  guncelleUI();
  logYaz('🗑️ Tüm hafızalar sıfırlandı.','uyari');
}
function ensembleRaporu(){
  logYaz("━━━ 🗳️ ENSEMBLE RAPORU (6'lı) ━━━",'ens');
  const s=ensemble.istatistik();
  logYaz(`   Toplam oylama: ${s.toplamOylama}`,'ens');
  logYaz(`   Q-Table:  ${s.q.w}K / ${s.q.l}Z  ağırlık=${s.q.wr.toFixed(3)}`,'ens');
  logYaz(`   DQN+PER:  ${s.dqn.w}K / ${s.dqn.l}Z  ağırlık=${s.dqn.wr.toFixed(3)}`,'ens');
  logYaz(`   PPO:      ${s.ppo.w}K / ${s.ppo.l}Z  ağırlık=${s.ppo.wr.toFixed(3)}`,'ens');
  logYaz(`   A2C:      ${s.a2c.w}K / ${s.a2c.l}Z  ağırlık=${s.a2c.wr.toFixed(3)}`,'ens');
  logYaz(`   TRF:      ${s.trf.w}K / ${s.trf.l}Z  ağırlık=${s.trf.wr.toFixed(3)}`,'trans');
  logYaz(`   MAML:     ${s.maml.w}K / ${s.maml.l}Z  ağırlık=${s.maml.wr.toFixed(3)}`,'maml');
  logYaz(`   🏆 En iyi: ${s.enIyi} (${(s.enIyiWR*100).toFixed(1)}%)`,'ens');
}

/* ============ EVENT BINDINGS + INIT ============ */
buildSymbolCards();
ogrenme.yukle(); genetik.yukle(); aiYukle(); qlearning.yukle();
dqnYukle(); pgYukle(); ppoYukle(); a2cYukle(); trfYukle(); mamlYukle(); ensemble.yukle();
modelSec('ensemble');
guncelleUI();
guncellePipelineUI();

