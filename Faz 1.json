function pgYukle(){try{const d=localStorage.getItem(PG_KEY); if(!d) return; const v=JSON.parse(d); for(const s of SYMBOLS) if(v[s]){state.symbols[s].pg=new PolicyGradient(s); state.symbols[s].pg.load(v[s]);}}catch(e){}}
function ppoKaydet(){try{const v={}; for(const s of SYMBOLS) if(state.symbols[s].ppo) v[s]=state.symbols[s].ppo.serialize(); localStorage.setItem(PPO_KEY,JSON.stringify(v));}catch(e){}}
function ppoYukle(){try{const d=localStorage.getItem(PPO_KEY); if(!d) return; const v=JSON.parse(d); for(const s of SYMBOLS) if(v[s]){state.symbols[s].ppo=new PPO(s); state.symbols[s].ppo.load(v[s]);}}catch(e){}}
function a2cKaydet(){try{const v={}; for(const s of SYMBOLS) if(state.symbols[s].a2c) v[s]=state.symbols[s].a2c.serialize(); localStorage.setItem(A2C_KEY,JSON.stringify(v));}catch(e){}}
function a2cYukle(){try{const d=localStorage.getItem(A2C_KEY); if(!d) return; const v=JSON.parse(d); for(const s of SYMBOLS) if(v[s]){state.symbols[s].a2c=new A2C(s); state.symbols[s].a2c.load(v[s]);}}catch(e){}}
function trfKaydet(){try{const v={}; for(const s of SYMBOLS) if(state.symbols[s].transformer) v[s]=state.symbols[s].transformer.serialize(); localStorage.setItem(TRF_KEY,JSON.stringify(v));}catch(e){}}
function trfYukle(){try{const d=localStorage.getItem(TRF_KEY); if(!d) return; const v=JSON.parse(d); for(const s of SYMBOLS) if(v[s]){state.symbols[s].transformer=new Transformer(s); state.symbols[s].transformer.load(v[s]);}}catch(e){}}
function mamlKaydet(){try{const v={}; for(const s of SYMBOLS) if(state.symbols[s].maml) v[s]=state.symbols[s].maml.serialize(); localStorage.setItem(MAML_KEY,JSON.stringify(v));}catch(e){}}
function mamlYukle(){try{const d=localStorage.getItem(MAML_KEY); if(!d) return; const v=JSON.parse(d); for(const s of SYMBOLS) if(v[s]){state.symbols[s].maml=new MAML(s); state.symbols[s].maml.load(v[s]);}}catch(e){}}

/* ============ TOPLU EĞİTİM FONKSİYONLARI ============ */
function dqnTopluEgit(){
  logYaz('🧠 DQN+PER V9 gerçek veri ile toplu eğitim...','dqn');
  let toplamEg=0;
  for(const sym of SYMBOLS){
    const s=state.symbols[sym];
    if(!s.dqn) s.dqn=new DQN(sym);
    const onceki=s.dqn.egitimSayaci;
    if(s.dqn.replayBuffer.length < DQN_BATCH){
      logYaz(`   ${sym}: buffer yetersiz (${s.dqn.replayBuffer.length}/${DQN_BATCH}) - eğitim atlandı, önce gerçek trade biriktir`,'uyari');
      continue;
    }
    for(let i=0;i<30;i++) s.dqn.train(multiAgent.sharedBuffer);
    logYaz(`   ${sym}: +${s.dqn.egitimSayaci-onceki} adım | buf=${s.dqn.replayBuffer.length} | ε=${s.dqn.epsilon.toFixed(3)} | loss=${s.dqn.sonLoss.toFixed(4)} | β=${s.dqn.priorityBeta.toFixed(2)}`,'dqn');
    toplamEg+=s.dqn.egitimSayaci-onceki;
  }
  dqnKaydet(); guncelleUI();
  if(toplamEg===0) logYaz('⚠️ DQN: Yeterli gerçek deneyim yok, önce botu çalıştırıp trade topla veya MA senkron kullan','uyari');
  else logYaz(`✅ DQN+PER V9 eğitim tamam. +${toplamEg} adım (gerçek veri).`,'dqn');
}
function ppoTopluEgit(){
  logYaz('🚀 PPO V9 gerçek veri ile toplu eğitim...','ppo');
  let toplamEp=0;
  for(const sym of SYMBOLS){
    const s=state.symbols[sym];
    if(!s.ppo) s.ppo=new PPO(sym);
    // V9: sadece geçmiş işlemlerden ve varsa ppo trajectory'den öğren, sentetik yok
    const hist=state.portfolio.islemGecmisi.filter(t=>t.sym===sym).slice(-20);
    if(hist.length>=3){
      for(const h of hist){
        if(h.rlState && h.rlState.length===RL_STATE_SIZE){
          const r=h.getiriYuzde||0;
          s.ppo.storeStep(h.rlState, h.rlAction??2, r);
        }
      }
      s.ppo.finishEpisode();
      toplamEp++;
    } else {
      logYaz(`   ${sym}: gerçek işlem geçmişi yetersiz (${hist.length}), sentetik eğitim V9'da devre dışı`,'uyari');
    }
    logYaz(`   ${sym}: ep=${s.ppo.episodeSayaci} loss=${s.ppo.sonLoss.toFixed(3)} H=${s.ppo.sonEntropi.toFixed(3)} clip=${(s.ppo.sonClipFrac*100).toFixed(1)}%`,'ppo');
  }
  ppoKaydet(); guncelleUI();
  if(toplamEp===0) logYaz('⚠️ PPO: Gerçek veri yok, önce botu çalıştır','uyari');
  else logYaz(`✅ PPO V9 eğitim tamam. +${toplamEp} episode (gerçek veri).`,'ppo');
}
function a2cTopluEgit(){
  logYaz('⚡ A2C V9 gerçek veri ile toplu eğitim...','a2c');
  let toplamEp=0;
  for(const sym of SYMBOLS){
    const s=state.symbols[sym];
    if(!s.a2c) s.a2c=new A2C(sym);
    const hist=state.portfolio.islemGecmisi.filter(t=>t.sym===sym).slice(-20);
    if(hist.length>=3){
      for(const h of hist){
        if(h.rlState && h.rlState.length===RL_STATE_SIZE){
          s.a2c.storeStep(h.rlState, h.rlAction??2, h.getiriYuzde||0);
        }
      }
      s.a2c.finishEpisode();
      toplamEp++;
    } else {
      logYaz(`   ${sym}: gerçek geçmiş yetersiz (${hist.length}), sentetik V9'da yok`,'uyari');
    }
    logYaz(`   ${sym}: ep=${s.a2c.episodeSayaci} loss=${s.a2c.sonLoss.toFixed(2)} H=${s.a2c.sonEntropi.toFixed(3)} |adv|=${s.a2c.sonAdv.toFixed(2)}`,'a2c');
  }
  a2cKaydet(); guncelleUI();
  if(toplamEp===0) logYaz('⚠️ A2C: Gerçek veri yok','uyari');
  else logYaz(`✅ A2C V9 eğitim tamam. +${toplamEp} episode (gerçek).`,'a2c');
}
async function trfTopluEgit(){
  logYaz('🔮 Transformer V9 gerçek veri ile toplu eğitim...','trans');
  let toplamEp=0;
  for(const sym of SYMBOLS){
    const s=state.symbols[sym];
    if(!s.transformer) s.transformer=new Transformer(sym);
    if(s.klines.length<20){try{s.klines=await klinesCek(sym,150,'1m');}catch(e){}}
    const seq=seqCikar(sym);
    const hist=state.portfolio.islemGecmisi.filter(t=>t.sym===sym).slice(-15);
    if(seq && hist.length>=2){
      // Gerçek sequence + gerçek reward'larla eğit
      for(let ep=0;ep<5;ep++){
        for(const h of hist){
          // Aynı seq'i kullan ama gerçek action/reward ile
          s.transformer.storeStep(seq, h.rlAction??2, h.getiriYuzde||0);
        }
        s.transformer.finishEpisode();
        toplamEp++;
      }
    } else if(seq){
      // Geçmiş yoksa en azından mevcut seq ile 1 ep boş değil ama reward 0 ile overfit engelleme için uyar
      logYaz(`   ${sym}: gerçek geçmiş yok, TRF eğitimi için en az 2 kapalı işlem gerek (V9'da sentetik yok)`,'uyari');
    }
    logYaz(`   ${sym}: ep=${s.transformer.episodeSayaci} loss=${s.transformer.sonLoss.toFixed(3)} H=${s.transformer.sonEntropi.toFixed(3)} clip=${(s.transformer.sonClipFrac*100).toFixed(1)}%`,'trans');
  }
  trfKaydet(); guncelleUI();
  if(toplamEp===0) logYaz('⚠️ TRF: Gerçek veri yok, sentetik devre dışı','uyari');
  else logYaz(`✅ Transformer V9 eğitim tamam. +${toplamEp} episode (gerçek).`,'trans');
}
async function mamlAdaptHepsi(){
  logYaz('🧬 MAML V9 tüm sembollere adapt (gerçek veri)...','maml');
  for(const sym of SYMBOLS){
    const s=state.symbols[sym];
    if(!s.maml) s.maml=new MAML(sym);
    let td=mamlTaskData(sym);
    if(td.length===0){
      logYaz(`   ${sym}: gerçek task data yok (en az 1 işlem gerekli), MAML adapt atlandı`,'uyari');
      continue;
    }
    s.maml.adapt(td);
    logYaz(`   ${sym}: adapt loss=${s.maml.sonAdaptLoss.toFixed(3)} taskSize=${td.length} innerStep=${s.maml.innerSteps}`,'maml');
  }
  mamlKaydet(); guncelleUI();
  logYaz(`✅ MAML V9 adapt tamam (Reptile + reward-weighted).`,'maml');
}
async function mtfYenile(){
  logYaz('🌐 MTF verileri yenileniyor...','mtf');
  for(const sym of SYMBOLS){
    try{
      await mtfYukle(sym);
      const mtf=mtfStateCikar(sym);
      logYaz(`   ${sym}: MTF state ${mtf?mtf.length:'-'} boyut`,'mtf');
    }catch(e){logYaz(`   ${sym} MTF hata: ${e.message}`,'hata');}
  }
  guncelleUI();
  logYaz('✅ MTF yenilendi.','mtf');
}

/* ============ ⚙️ OTOMATİK PIPELINE (YENİ) ============ */
const pipeline={
  running:false,currentStage:-1,startTime:0,stageStartTime:0,timerHandle:null,
  stages:[
    {id:'ai',name:'AI Eğitimi',status:'pending',dur:0,info:''},
    {id:'gen',name:'Genetik Optimizasyon',status:'pending',dur:0,info:''},
    {id:'mtf',name:'Multi-Timeframe Yükle',status:'pending',dur:0,info:''},
    {id:'trf',name:'Transformer Eğitim',status:'pending',dur:0,info:''},
    {id:'dqn',name:'DQN+PER Eğitim',status:'pending',dur:0,info:''},
    {id:'ppo',name:'PPO Eğitim',status:'pending',dur:0,info:''},
    {id:'a2c',name:'A2C Eğitim',status:'pending',dur:0,info:''},
    {id:'maml',name:'MAML Adapt',status:'pending',dur:0,info:''},
    {id:'ma',name:'MA Senkron',status:'pending',dur:0,info:''},
    {id:'ens',name:'Ensemble Hazırlık',status:'pending',dur:0,info:''}
  ],
  async calistir(){
    if(this.running){logYaz('⚠️ Pipeline zaten çalışıyor.','uyari'); return;}
    this.running=true;
    this.startTime=Date.now();
    this.timerHandle=setInterval(()=>guncellePipelineUI(),300);
    logYaz('━━━ 🚀 OTOMATİK EĞİTİM PIPELINE BAŞLADI ━━━','basari');
    const btn=els.pipeBtn;
    btn.disabled=true; btn.textContent='⏳ Pipeline çalışıyor...';

    for(let i=0;i<this.stages.length;i++){
      if(!this.running){
        logYaz('⏹ Pipeline iptal edildi.','uyari');
        break;
      }
      const stage=this.stages[i];
      this.currentStage=i;
      stage.status='running';
      this.stageStartTime=Date.now();
      guncellePipelineUI();
      logYaz(`▶ [${i+1}/${this.stages.length}] ${stage.name} başlıyor...`,'islem');

      try{
        if(stage.id==='ai') await aiEgitTumSemboller();
        else if(stage.id==='gen') await genetikCalistir();
        else if(stage.id==='mtf') await mtfYenile();
        else if(stage.id==='trf') await trfTopluEgit();
        else if(stage.id==='dqn') dqnTopluEgit();
        else if(stage.id==='ppo') ppoTopluEgit();
        else if(stage.id==='a2c') a2cTopluEgit();
        else if(stage.id==='maml') await mamlAdaptHepsi();
        else if(stage.id==='ma'){
          if(multiAgent.sharedBuffer.length===0){
            logYaz('⚠️ MA buffer boş - V9\'da sentetik doldurma yok, önce gerçek deneyim biriktir','uyari');
          } else {
            multiAgent.senkronize();
          }
        }
        else if(stage.id==='ens'){
          for(const sym of SYMBOLS){
            const s=state.symbols[sym];
            if(!s.dqn) s.dqn=new DQN(sym);
            if(!s.ppo) s.ppo=new PPO(sym);
            if(!s.a2c) s.a2c=new A2C(sym);
            if(!s.transformer) s.transformer=new Transformer(sym);
            if(!s.maml) s.maml=new MAML(sym);
          }
          logYaz('✅ 6 model hazır. Ensemble oylaması aktif.','ens');
        }
        stage.status='done';
        stage.dur=Date.now()-this.stageStartTime;
        stage.info='✓ tamamlandı';
        logYaz(`✅ [${i+1}/${this.stages.length}] ${stage.name} tamam (${(stage.dur/1000).toFixed(1)}s)`,'basari');
      }catch(e){
        stage.status='error';
        stage.dur=Date.now()-this.stageStartTime;
        stage.info=e.message.slice(0,50);
        logYaz(`❌ [${i+1}/${this.stages.length}] ${stage.name} HATA: ${e.message}`,'hata');
      }
      guncellePipelineUI();
      await new Promise(r=>setTimeout(r,200));
    }
    this.running=false;
    if(this.timerHandle){clearInterval(this.timerHandle); this.timerHandle=null;}
    const totalDur=Date.now()-this.startTime;
    logYaz(`━━━ ✅ PIPELINE TAMAM — ${(totalDur/1000).toFixed(1)}s ━━━`,'basari');
    logYaz('💡 Ensemble modu aktif. "BAŞLAT" butonuna bas.','bilgi');
    btn.disabled=false; btn.textContent='▶ OTOMATİK EĞİTİM';
    modelSec('ensemble');
    // Son kez timer'ı güncelle
    guncellePipelineUI();
  },
  durdur(){
    if(!this.running) return;
    this.running=false;
    const stage=this.stages[this.currentStage];
    if(stage&&stage.status==='running'){
      stage.status='cancelled';
      stage.info='⏹ iptal';
      stage.dur=Date.now()-this.stageStartTime;
    }
    if(this.timerHandle){clearInterval(this.timerHandle); this.timerHandle=null;}
    const btn=els.pipeBtn;
    if(btn){btn.disabled=false; btn.textContent='▶ OTOMATİK EĞİTİM';}
    logYaz('━━━ ⏹ PIPELINE DURDURULDU ━━━','uyari');
    guncellePipelineUI();
  },
  sifirla(){
    this.running=false;
    this.currentStage=-1;
    this.startTime=0;
    for(const s of this.stages){s.status='pending'; s.dur=0; s.info='';}
    if(this.timerHandle){clearInterval(this.timerHandle); this.timerHandle=null;}
    const btn=els.pipeBtn;
    if(btn){btn.disabled=false; btn.textContent='▶ OTOMATİK EĞİTİM';}
    guncellePipelineUI();
    logYaz('🔄 Pipeline tablosu sıfırlandı.','bilgi');
  }
};
function guncellePipelineUI(){
  const tb=els.pipeBody;
  if(!tb) return;
  const icons={pending:'○',running:'⏳',done:'✓',error:'❌',cancelled:'⏹'};
  tb.innerHTML=pipeline.stages.map((s,i)=>{
    const icon=icons[s.status]||'○';
    const dur=s.dur>0?(s.dur/1000).toFixed(1)+'s':'-';
    return `<tr class="p-${s.status}"><td>${i+1}</td><td>${s.name}</td><td>${icon} ${s.status}</td><td>${dur}</td><td>${s.info||''}</td></tr>`;
  }).join('');
  const timer=els.pipeTimer;
  if(!timer) return;
  if(pipeline.running){
    const el=Date.now()-pipeline.startTime;
    timer.textContent=`⏱ Toplam: ${(el/1000).toFixed(1)}s`;
    timer.style.color='#10b981';
    const st=els.statPipeState; if(st) st.textContent='Çalışıyor';
    const sts=els.statPipeSub;
    if(sts) sts.textContent=`Aşama ${pipeline.currentStage+1}/${pipeline.stages.length}`;
  } else if(pipeline.startTime>0){
    const el=Date.now()-pipeline.startTime;
    timer.textContent=`✅ Bitti: ${(el/1000).toFixed(1)}s`;
    timer.style.color='#fde68a';
    const st=els.statPipeState; if(st) st.textContent='Tamamlandı';
    const sts=els.statPipeSub; if(sts) sts.textContent=`${(el/1000).toFixed(1)}s`;
  } else {
    timer.textContent='Bekleniyor...';
    timer.style.color='#6b7280';
    const st=els.statPipeState; if(st) st.textContent='Bekliyor';
    const sts=els.statPipeSub; if(sts) sts.textContent='-';
  }
}


/* ============ V9 OTOMATİK YENİLEME ============ */
let mtfInterval=null, orderbookInterval=null;
function baslatOtoYenileme(){
  if(mtfInterval) clearInterval(mtfInterval);
  if(orderbookInterval) clearInterval(orderbookInterval);
  mtfInterval=setInterval(async ()=>{
    for(const sym of SYMBOLS){
      try{await mtfYukle(sym);}catch(e){}
    }
    logYaz('🌐 MTF otomatik yenilendi','mtf');
    guncelleUI();
  }, MTF_REFRESH_MS);
  orderbookInterval=setInterval(async ()=>{
    for(const sym of SYMBOLS){
      try{
        const ob=await orderbookCek(sym,50);
        state.symbols[sym].orderbook=ob;
      }catch(e){}
    }
  }, ORDERBOOK_REFRESH_MS);
}
function durdurOtoYenileme(){
  if(mtfInterval){clearInterval(mtfInterval); mtfInterval=null;}
  if(orderbookInterval){clearInterval(orderbookInterval); orderbookInterval=null;}
}


/* ============ PORTFÖY ============ */
function toplamBakiye(){
  let t=state.portfolio.bakiye;
  for(const sym of SYMBOLS){
    const p=state.symbols[sym].position;
    if(p){
      const cur=state.symbols[sym].ticker.fiyat||p.girisFiyat;
      if(p.yon==='AL') t+=p.miktar*cur;
      else t+=p.miktar*p.girisFiyat+(p.girisFiyat-cur)*p.miktar;
      // fee already deducted from bakiye, unrealized gross only
    }
  }
  return t;
}
function toplamFee(){return state.portfolio.toplamFee||0;}
function bekleyenIslemSayisi(){let n=0; for(const sym of SYMBOLS) if(state.symbols[sym].position) n++; return n;}

