  }
  aiKaydet(); guncelleUI(); logYaz('✅ AI eğitimi tamamlandı.','ai');
}
function aiKaydet(){try{const v={}; for(const sym of SYMBOLS) if(state.symbols[sym].mlp) v[sym]=state.symbols[sym].mlp.serialize(); localStorage.setItem(AI_KEY,JSON.stringify(v));}catch(e){}}
function aiYukle(){try{const d=localStorage.getItem(AI_KEY); if(!d) return; const v=JSON.parse(d); for(const sym of SYMBOLS) if(v[sym]){state.symbols[sym].mlp=new MLP(); state.symbols[sym].mlp.load(v[sym]);}}catch(e){}}
function aiSifirla(){
