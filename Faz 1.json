async function klinesCek(sym,limit=150,interval='1m'){
  const r=await fetch(`${REST_BASE}/klines?symbol=${sym}&interval=${interval}&limit=${limit}`);
  if(!r.ok) throw new Error(sym+' klines HTTP '+r.status);
  const raw=await r.json();
  return raw.map(k=>({time:+k[0],open:+k[1],high:+k[2],low:+k[3],close:+k[4],volume:+k[5],closeTime:+k[6]}));
}
async function orderbookCek(sym,limit=100){
  const r=await fetch(`${REST_BASE}/depth?symbol=${sym}&limit=${limit}`);
  if(!r.ok) throw new Error(sym+' depth HTTP '+r.status);
  const d=await r.json();
  const bids=d.bids.map(b=>({price:+b[0],qty:+b[1]}));
  const asks=d.asks.map(a=>({price:+a[0],qty:+a[1]}));
  return {bids,asks,
    bidLiquidity:bids.reduce((s,b)=>s+b.price*b.qty,0),
    askLiquidity:asks.reduce((s,a)=>s+a.price*a.qty,0),
    spread:asks[0].price-bids[0].price,
    midPrice:(bids[0].price+asks[0].price)/2};
}
async function mtfYukle(sym){
  const [k1,k5,k15] = await Promise.all([
    klinesCek(sym,150,'1m'),
    klinesCek(sym,100,'5m'),
    klinesCek(sym,100,'15m')
  ]);
  const s=state.symbols[sym];
  s.klines=k1; s.klines5m=k5; s.klines15m=k15;
  s._lastMtfFetch=Date.now();
  return {k1,k5,k15};
}
function wsBaslat(sym){
  return new Promise((resolve,reject)=>{
    const ws=new WebSocket(`wss://stream.binance.com:9443/ws/${sym.toLowerCase()}@kline_1m`);
    const s=state.symbols[sym];
    ws.onopen=()=>{state.wsAktif++; updateWsDurum(); logYaz(`WS bağlı: ${sym}`,'basari'); resolve(ws);};
    ws.onerror=()=>reject(new Error(sym+' WS hata'));
    ws.onclose=()=>{state.wsAktif=Math.max(0,state.wsAktif-1); updateWsDurum();};
    ws.onmessage=ev=>{
      try{
        const msg=JSON.parse(ev.data);
        if(msg.k){
          s.ticker.prevFiyat=s.ticker.fiyat;
          s.ticker.fiyat=parseFloat(msg.k.c);
          state.veriSayisi++;
