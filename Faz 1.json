els.sifirlaBtn.addEventListener('click',hafizaSifirla);
els.modeQTable.addEventListener('click',()=>modelSec('qtable'));
els.modeDQN.addEventListener('click',()=>modelSec('dqn'));
els.modePG.addEventListener('click',()=>modelSec('policy'));
els.modePPO.addEventListener('click',()=>modelSec('ppo'));
els.modeA2C.addEventListener('click',()=>modelSec('a2c'));
els.modeTRF.addEventListener('click',()=>modelSec('transformer'));
els.modeMAML.addEventListener('click',()=>modelSec('maml'));
els.modeENS.addEventListener('click',()=>modelSec('ensemble'));

els.pipeBtn.addEventListener('click',()=>{
  if(pipeline.running) pipeline.durdur();
  else {
    if(state.running){logYaz('⚠️ Bot çalışırken pipeline başlatılamaz. Önce durdur.','uyari'); return;}
    if(!confirm("Otomatik eğitim pipeline'ı başlatılsın mı? (~1-2 dakika sürebilir)")) return;
    pipeline.sifirla();
    pipeline.calistir();
  }
});
els.pipeResetBtn.addEventListener('click',()=>pipeline.sifirla());

logYaz("🤖 Bot v9.0 FAZ1 hazır - Transformer Full Train + MAML Reptile + ATR Risk + Gerçek Veri" — Transformer + MAML + MTF + 6'lı Ensemble.",'basari');
logYaz("   💡 En hızlısı: 'OTOMATİK EĞİTİM' butonuna bas → hepsi sırayla çalışır. Sayaç tablosu canlı güncellenir.",'bilgi');
