}

/* ============ Q-LEARNING ============ */
const Q_KEY='bot_q_v2';
const qlearning={
  Q:{},egitimSayaci:0,toplamReward:0,sonState:{},
  stateHesapla(sym){
    const s=state.symbols[sym];
    const rsi=s.indicators.rsi??50;
    let rsiB=2;
    if(rsi<30) rsiB=0; else if(rsi<45) rsiB=1; else if(rsi<55) rsiB=2; else if(rsi<70) rsiB=3; else rsiB=4;
    const e20=s.indicators.ema20??0,e50=s.indicators.ema50??0;
    let trend=1;
    if(e50>0){if(e20<e50*0.998) trend=0; else if(e20>e50*1.002) trend=2;}
    const son=state.portfolio.islemGecmisi.slice(-3);
    let sonR=0;
    if(son.length){const kz=son.filter(t=>t.getiri>0).length; if(kz===3) sonR=3; else if(kz===2) sonR=2; else if(kz===1) sonR=1;}
    const pos=s.position?1:0;
    return rsiB*1000+trend*100+sonR*10+pos;
  },
  actionSec(sid){
    if(!this.Q[sid]){this.Q[sid]=[0,0,0,0]; this.Q[sid]._v=0;}
    const visits=this.Q[sid]._v||0;
    const eps=Math.max(0.05,Q_EPSILON*Math.exp(-visits/20));
    this.Q[sid]._v=visits+1;
    if(Math.random()<eps) return Math.floor(Math.random()*Q_ACTIONS);
    let maxQ=-Infinity,maxA=0;
    for(let a=0;a<Q_ACTIONS;a++) if(this.Q[sid][a]>maxQ){maxQ=this.Q[sid][a]; maxA=a;}
    return maxA;
  },
  actionGreedy(sid){
    if(!this.Q[sid]) this.Q[sid]=[0,0,0,0];
    let maxQ=-Infinity,maxA=0;
    for(let a=0;a<Q_ACTIONS;a++) if(this.Q[sid][a]>maxQ){maxQ=this.Q[sid][a]; maxA=a;}
    return maxA;
  },
  actionAdi(a){return ['atla','0.5x','1.0x','2.0x'][a]??'?';},
  actionRiskCarpan(a){return [0,0.5,1.0,2.0][a]??1.0;},
  islemBaslat(sym,action,sid){this.sonState[sym]={sid,action,ts:Date.now()};},
  ogren(sym,gy){
    const k=this.sonState[sym]; if(!k) return;
    const {sid,action}=k;
    const sonrakiSid=this.stateHesapla(sym);
    const reward=gy*10;
    if(!this.Q[sid]) this.Q[sid]=[0,0,0,0];
    if(!this.Q[sonrakiSid]) this.Q[sonrakiSid]=[0,0,0,0];
    const maxNext=Math.max(...this.Q[sonrakiSid].slice(0,4));
    const eskiQ=this.Q[sid][action];
    this.Q[sid][action]=eskiQ+Q_ALPHA*(reward+Q_GAMMA*maxNext-eskiQ);
    this.egitimSayaci++; this.toplamReward+=reward;
    logYaz(`🎯 Q-öğren: s=${sid} a=${action} r=${reward.toFixed(1)} Q ${eskiQ.toFixed(2)}→${this.Q[sid][action].toFixed(2)}`,'q');
    delete this.sonState[sym]; this.kaydet();
  },
  istatistik(){const sids=Object.keys(this.Q); let ort=0,say=0; for(const qs of Object.values(this.Q)) for(let i=0;i<4;i++){const q=qs[i]; if(typeof q==='number'){ort+=q; say++;}} return {states:sids.length,ortalama:say?ort/say:0,egitim:this.egitimSayaci,toplamReward:this.toplamReward};},
  kaydet(){try{const clean={}; for(const [k,v] of Object.entries(this.Q)) clean[k]={0:v[0],1:v[1],2:v[2],3:v[3],_v:v._v||0}; localStorage.setItem(Q_KEY,JSON.stringify({Q:clean,egitimSayaci:this.egitimSayaci,toplamReward:this.toplamReward}));}catch(e){}},
  yukle(){try{const d=localStorage.getItem(Q_KEY); if(d){const p=JSON.parse(d); this.Q={}; for(const [k,v] of Object.entries(p.Q||{})) this.Q[k]=Object.assign([v[0],v[1],v[2],v[3]],{_v:v._v||0}); this.egitimSayaci=p.egitimSayaci||0; this.toplamReward=p.toplamReward||0;}}catch(e){}},
  sifirla(){this.Q={}; this.egitimSayaci=0; this.toplamReward=0; this.sonState={}; try{localStorage.removeItem(Q_KEY);}catch(e){}; guncelleUI(); logYaz('🗑️ Q-Table sıfırlandı.','uyari');}
};

/* ============ GENETİK ============ */
const GEN_POP=20,GEN_NESIL=10,GEN_MUT=0.15,GENETIC_KEY='bot_genetic_v2';
const genetik={
  populasyon:[],nesil:0,enIyi:null,calisiyor:false,
  rastgele(){return {rsiAl:Math.floor(20+Math.random()*20),rsiSat:Math.floor(60+Math.random()*20),atrMax:+(2+Math.random()*6).toFixed(2),emaKisa:[10,15,20,25,30][Math.floor(Math.random()*5)],emaUzun:[40,50,60,80,100][Math.floor(Math.random()*5)],likiditeMin:Math.floor((200000+Math.random()*1800000)/100000)*100000,spreadMax:+(0.02+Math.random()*0.1).toFixed(3),riskPct:+(0.005+Math.random()*0.03).toFixed(3),fitnes:-Infinity};},
  onbellek(klines){
    const closes=klines.map(k=>k.close);
    const c={closes,rsi:rsiSeries(closes,14),atr:atrSeries(klines,14),emaKisa:{},emaUzun:{}};
    for(const p of [10,15,20,25,30]) c.emaKisa[p]=emaSeries(closes,p);
    for(const p of [40,50,60,80,100]) c.emaUzun[p]=emaSeries(closes,p);
    return c;
  },
  fitnesHesapla(kr,klines,cache){
    if(!klines||klines.length<60) return -Infinity;
    const closes=cache.closes,rsiArr=cache.rsi,eK=cache.emaKisa[kr.emaKisa],eU=cache.emaUzun[kr.emaUzun];
    let bakiye=10000,poz=null,maxB=bakiye,maxDD=0,isl=0,kz=0;
    for(let i=60;i<klines.length;i++){
      const fiyat=closes[i],rsi=rsiArr[i],ek=eK[i],eu=eU[i];
      if(poz){
        let kapa=false;
        if(poz.yon==='AL'){if(fiyat<=poz.stop||fiyat>=poz.hedef) kapa=true; else if(rsi>kr.rsiSat&&i>poz.ac+5) kapa=true;}
        else{if(fiyat>=poz.stop||fiyat<=poz.hedef) kapa=true; else if(rsi<kr.rsiAl&&i>poz.ac+5) kapa=true;}
        if(kapa){const g=poz.yon==='AL'?(fiyat-poz.g)*poz.m:(poz.g-fiyat)*poz.m; bakiye+=poz.m*poz.g+g; if(g>0) kz++; isl++; poz=null; if(bakiye>maxB) maxB=bakiye; const dd=(maxB-bakiye)/Math.max(maxB,1); if(dd>maxDD) maxDD=dd;}
      }
      if(!poz&&rsi!=null&&ek!=null&&eu!=null){
        let sinyal=null;
        if(rsi<kr.rsiAl&&ek>eu) sinyal='AL'; else if(rsi>kr.rsiSat&&ek<eu) sinyal='SAT';
        if(sinyal){const mTL=bakiye*kr.riskPct; if(mTL<10) continue; const m=mTL/fiyat; poz={yon:sinyal,g:fiyat,m,stop:sinyal==='AL'?fiyat*0.99:fiyat*1.01,hedef:sinyal==='AL'?fiyat*1.02:fiyat*0.98,ac:i}; bakiye-=mTL;}
      }
    }
    if(poz){const fiyat=closes[closes.length-1]; const g=poz.yon==='AL'?(fiyat-poz.g)*poz.m:(poz.g-fiyat)*poz.m; bakiye+=poz.m*poz.g+g; if(g>0) kz++; isl++;}
    const karPct=(bakiye-10000)/10000*100;
    const ceza=isl<3?-5:0;
    const wr=isl>0?kz/isl:0;
    return karPct-maxDD*100*0.5+ceza+wr*5;
  },
  baslat(){this.populasyon=[]; if(this.enIyi) this.populasyon.push({...this.enIyi}); while(this.populasyon.length<GEN_POP) this.populasyon.push(this.rastgele()); this.nesil=0;},
  sec(){const a=this.populasyon[Math.floor(Math.random()*this.populasyon.length)],b=this.populasyon[Math.floor(Math.random()*this.populasyon.length)]; return a.fitnes>b.fitnes?a:b;},
  caprazla(a,b){const c={}; for(const k of ['rsiAl','rsiSat','atrMax','emaKisa','emaUzun','likiditeMin','spreadMax','riskPct']) c[k]=Math.random()<0.5?a[k]:b[k]; c.fitnes=-Infinity; return c;},
  mutasyon(c){
    if(Math.random()<GEN_MUT) c.rsiAl=Math.max(15,Math.min(45,c.rsiAl+(Math.random()<0.5?-3:3)));
    if(Math.random()<GEN_MUT) c.rsiSat=Math.max(55,Math.min(85,c.rsiSat+(Math.random()<0.5?-3:3)));
    if(Math.random()<GEN_MUT) c.atrMax=+Math.max(1,Math.min(10,c.atrMax+(Math.random()-0.5))).toFixed(2);
    if(Math.random()<GEN_MUT) c.emaKisa=[10,15,20,25,30][Math.floor(Math.random()*5)];
    if(Math.random()<GEN_MUT) c.emaUzun=[40,50,60,80,100][Math.floor(Math.random()*5)];
    if(Math.random()<GEN_MUT) c.likiditeMin=Math.floor((100000+Math.random()*2000000)/100000)*100000;
    if(Math.random()<GEN_MUT) c.spreadMax=+(0.02+Math.random()*0.1).toFixed(3);
    if(Math.random()<GEN_MUT) c.riskPct=+(0.005+Math.random()*0.03).toFixed(3);
    return c;
  },
  async nesilEvrim(klines,cache){
    for(const c of this.populasyon) c.fitnes=this.fitnesHesapla(c,klines,cache);
    this.populasyon.sort((a,b)=>b.fitnes-a.fitnes);
    if(!this.enIyi||this.populasyon[0].fitnes>this.enIyi.fitnes) this.enIyi={...this.populasyon[0]};
    logYaz(`🧬 Nesil ${this.nesil+1}/${GEN_NESIL} | En iyi: ${this.populasyon[0].fitnes.toFixed(2)} | RSI ${this.populasyon[0].rsiAl}/${this.populasyon[0].rsiSat}`,'gen');
    const yp=[{...this.populasyon[0]},{...this.populasyon[1]}];
    while(yp.length<GEN_POP){let c=this.caprazla(this.sec(),this.sec()); c=this.mutasyon(c); yp.push(c);}
    this.populasyon=yp; this.nesil++;
  },
  yukle(){try{const d=localStorage.getItem(GENETIC_KEY); if(d) this.enIyi=JSON.parse(d);}catch(e){}},
  kaydet(){try{localStorage.setItem(GENETIC_KEY,JSON.stringify(this.enIyi));}catch(e){}}
};
async function genetikCalistir(){
  if(genetik.calisiyor) return;
  if(state.running){logYaz('⚠️ Bot çalışırken genetik başlatılamaz.','uyari'); return;}
  genetik.calisiyor=true; els.genBtn.disabled=true; els.genBtn.textContent='⏳...';
  logYaz('━━━ 🧬 GENETİK OPTİMİZASYON ━━━','gen');
  try{
    const klines=await klinesCek('BTCUSDT',500,'1m');
    const cache=genetik.onbellek(klines);
    genetik.baslat();
    for(let n=0;n<GEN_NESIL;n++){await genetik.nesilEvrim(klines,cache); guncelleUI(); await new Promise(r=>setTimeout(r,30));}
    genetik.kaydet();
    logYaz(`✅ Genetik tamamlandı. Fitnes ${genetik.enIyi.fitnes.toFixed(2)}`,'gen');
  }catch(e){logYaz('GENETİK HATA: '+e.message,'hata');}
  finally{genetik.calisiyor=false; els.genBtn.disabled=false; els.genBtn.textContent='🧬 GENETİK'; guncelleUI();}
}

/* ============ DQN + PER ============ */
class DQN{
  constructor(sym){
    this.sym=sym; this.stateSize=RL_STATE_SIZE; this.actionSize=Q_ACTIONS; this.hiddenSize=DQN_HIDDEN;
    this.lr=0.001; this.gamma=0.95; this.epsilon=1.0; this.epsilonMin=0.05; this.epsilonDecay=0.995;
    this.replayBuffer=[]; this.priorities=[];
    this.batchSize=DQN_BATCH; this.targetUpdateFreq=50; this.updateCounter=0;
    this.egitimSayaci=0; this.sonLoss=0;
    this.priorityAlpha=0.6; this.priorityBeta=0.4; this.priorityEps=1e-5;
    this.betaIncrement=0.0005; this.maxPriority=1.0;
    this._initNetwork(); this._initTarget();
  }
  _initNetwork(){
    const rnd=()=>(Math.random()-0.5)*2;
    this.W1=Array.from({length:this.hiddenSize},()=>Array.from({length:this.stateSize},()=>rnd()*Math.sqrt(2/this.stateSize)));
    this.b1=new Array(this.hiddenSize).fill(0);
    this.W2=Array.from({length:this.actionSize},()=>Array.from({length:this.hiddenSize},()=>rnd()*Math.sqrt(2/this.hiddenSize)));
    this.b2=new Array(this.actionSize).fill(0);
  }
  _initTarget(){this.tW1=this.W1.map(r=>[...r]); this.tb1=[...this.b1]; this.tW2=this.W2.map(r=>[...r]); this.tb2=[...this.b2];}
  _forward(x,target=false){
    const W1=target?this.tW1:this.W1,b1=target?this.tb1:this.b1;
    const W2=target?this.tW2:this.W2,b2=target?this.tb2:this.b2;
    const h=new Array(this.hiddenSize);
    for(let i=0;i<this.hiddenSize;i++){let s=b1[i]; for(let j=0;j<this.stateSize;j++) s+=W1[i][j]*x[j]; h[i]=s>0?s:0;}
    const out=new Array(this.actionSize);
    for(let a=0;a<this.actionSize;a++){let s=b2[a]; for(let i=0;i<this.hiddenSize;i++) s+=W2[a][i]*h[i]; out[a]=s;}
    return {h,out};
  }
  predict(x){return this._forward(x,false).out;}
  actionSec(x){
    if(Math.random()<this.epsilon) return Math.floor(Math.random()*this.actionSize);
    const qs=this.predict(x); let maxQ=-Infinity,maxA=0;
    for(let a=0;a<this.actionSize;a++) if(qs[a]>maxQ){maxQ=qs[a]; maxA=a;}
    return maxA;
  }
  actionGreedy(x){const qs=this.predict(x); let maxQ=-Infinity,maxA=0; for(let a=0;a<this.actionSize;a++) if(qs[a]>maxQ){maxQ=qs[a]; maxA=a;} return maxA;}
  store(s,a,r,s2,done,priority=null){
    this.replayBuffer.push({s,a,r,s2,d:done});
    const p=priority!=null?priority:this.maxPriority;
    this.priorities.push(Math.pow(Math.abs(p)+this.priorityEps,this.priorityAlpha));
    if(this.replayBuffer.length>DQN_BUFFER_MAX){this.replayBuffer.shift(); this.priorities.shift();}
    if(p>this.maxPriority) this.maxPriority=p;
  }
  _samplePrioritized(bs){
    const N=this.replayBuffer.length;
    if(N===0) return null;
    const total=this.priorities.reduce((a,b)=>a+b,0);
    if(total<=0) return null;
    const probs=this.priorities.map(p=>p/total);
    const batch=[],indices=[],weights=[];
    for(let i=0;i<bs;i++){
      let r=Math.random(),cum=0,idx=N-1;
      for(let j=0;j<N;j++){cum+=probs[j]; if(r<=cum){idx=j; break;}}
      indices.push(idx); batch.push(this.replayBuffer[idx]);
      const w=Math.pow(N*probs[idx]+1e-8,-this.priorityBeta);
      weights.push(w);
    }
    const maxW=Math.max(...weights)||1;
    this.priorityBeta=Math.min(1.0,this.priorityBeta+this.betaIncrement);
    return {batch,indices,weights:weights.map(w=>w/maxW)};
  }
  train(sharedBuffer=null){
    if(this.replayBuffer.length<this.batchSize&&(!sharedBuffer||sharedBuffer.length<this.batchSize)) return;
    const sampled=this._samplePrioritized(this.batchSize);
    if(!sampled) return;
    let {batch,indices,weights}=sampled;
    if(sharedBuffer&&sharedBuffer.length>0){
      const nOrtak=Math.floor(this.batchSize/4);
      for(let i=0;i<nOrtak&&i<batch.length;i++){
        batch[i]=sharedBuffer[Math.floor(Math.random()*sharedBuffer.length)];
        indices[i]=-1; weights[i]=1.0;
      }
    }
    this._trainBatch(batch,indices,weights);
  }
  _trainBatch(batch,indices=null,weights=null){
    if(batch.length===0) return;
    let totalLoss=0;
    const tdErrors=[];
    for(let bi=0;bi<batch.length;bi++){
      const exp=batch[bi]; const w=weights?weights[bi]:1.0;
      const {h,out}=this._forward(exp.s,false);
      const tOut=this._forward(exp.s2,true).out;
      const maxNext=Math.max(...tOut);
      const targetQ=exp.d?exp.r:exp.r+this.gamma*maxNext;
      const err=out[exp.a]-targetQ;
      tdErrors.push(Math.abs(err));
      totalLoss+=w*err*err;
      const dOut=new Array(this.actionSize).fill(0);
      dOut[exp.a]=Math.max(-5,Math.min(5,err*w));
      const dH=new Array(this.hiddenSize).fill(0);
      for(let i=0;i<this.hiddenSize;i++){let sum=0; for(let a=0;a<this.actionSize;a++) sum+=dOut[a]*this.W2[a][i]; dH[i]=sum*(h[i]>0?1:0);}
      for(let a=0;a<this.actionSize;a++){for(let i=0;i<this.hiddenSize;i++) this.W2[a][i]-=this.lr*dOut[a]*h[i]; this.b2[a]-=this.lr*dOut[a];}
      for(let i=0;i<this.hiddenSize;i++){for(let j=0;j<this.stateSize;j++) this.W1[i][j]-=this.lr*dH[i]*exp.s[j]; this.b1[i]-=this.lr*dH[i];}
      this.egitimSayaci++;
    }
    if(indices){
      for(let i=0;i<indices.length;i++){
        if(indices[i]<0) continue;
        const p=Math.pow(tdErrors[i]+this.priorityEps,this.priorityAlpha);
        if(indices[i]<this.priorities.length) this.priorities[indices[i]]=p;
        if(p>this.maxPriority) this.maxPriority=p;
      }
    }
    this.sonLoss=totalLoss/batch.length;
    this.updateCounter++;
    if(this.updateCounter>=this.targetUpdateFreq){
      this.updateCounter=0;
      this.tW1=this.W1.map(r=>[...r]); this.tb1=[...this.b1];
      this.tW2=this.W2.map(r=>[...r]); this.tb2=[...this.b2];
    }
    if(this.epsilon>this.epsilonMin) this.epsilon*=this.epsilonDecay;
  }
  serialize(){return {W1:this.W1,b1:this.b1,W2:this.W2,b2:this.b2,tW1:this.tW1,tb1:this.tb1,tW2:this.tW2,tb2:this.tb2,epsilon:this.epsilon,egitimSayaci:this.egitimSayaci,sonLoss:this.sonLoss,replayBuffer:this.replayBuffer.slice(-500),priorities:this.priorities.slice(-500),maxPriority:this.maxPriority};}
  load(d){if(!d) return; Object.assign(this,d); if(Array.isArray(d.replayBuffer)) this.replayBuffer=d.replayBuffer; if(Array.isArray(d.priorities)) this.priorities=d.priorities; else this.priorities=new Array(this.replayBuffer.length).fill(1.0);}
}

/* ============ PG ============ */
class PolicyGradient{
  constructor(sym){
    this.sym=sym; this.stateSize=RL_STATE_SIZE; this.actionSize=Q_ACTIONS; this.hiddenSize=PG_HIDDEN;
    this.lr=0.005; this.gamma=0.95; this.entropyBonus=0.01;
    this.baseline=0; this.baselineAlpha=0.05;
    this.trajectory=[]; this.egitimSayaci=0; this.episodeSayaci=0;
    this.toplamReward=0; this.sonEntropi=0;
    this._initNetwork();
  }
  _initNetwork(){
    const rnd=()=>(Math.random()-0.5)*2;
    this.W1=Array.from({length:this.hiddenSize},()=>Array.from({length:this.stateSize},()=>rnd()*Math.sqrt(2/this.stateSize)));
    this.b1=new Array(this.hiddenSize).fill(0);
    this.W2=Array.from({length:this.actionSize},()=>Array.from({length:this.hiddenSize},()=>rnd()*Math.sqrt(2/this.hiddenSize)));
    this.b2=new Array(this.actionSize).fill(0);
  }
  _forward(x){
    const h=new Array(this.hiddenSize);
    for(let i=0;i<this.hiddenSize;i++){let s=this.b1[i]; for(let j=0;j<this.stateSize;j++) s+=this.W1[i][j]*x[j]; h[i]=Math.tanh(s);}
    const logits=new Array(this.actionSize);
    for(let a=0;a<this.actionSize;a++){let s=this.b2[a]; for(let i=0;i<this.hiddenSize;i++) s+=this.W2[a][i]*h[i]; logits[a]=s;}
    const maxL=Math.max(...logits);
    const exps=logits.map(l=>Math.exp(l-maxL));
    const sumE=exps.reduce((a,b)=>a+b,0);
    const probs=exps.map(e=>e/sumE);
    return {h,probs};
  }
  actionSec(x){
    const {probs}=this._forward(x);
    let r=Math.random(),cum=0;
    for(let a=0;a<this.actionSize;a++){cum+=probs[a]; if(r<=cum) return a;}
    return this.actionSize-1;
  }
  storeStep(s,a,r){this.trajectory.push({s,a,r});}
  finishEpisode(){
    if(this.trajectory.length===0) return;
    const T=this.trajectory.length;
    const G=new Array(T).fill(0);
    let running=0;
    for(let t=T-1;t>=0;t--){running=this.trajectory[t].r+this.gamma*running; G[t]=running;}
    const avgG=G.reduce((a,b)=>a+b,0)/T;
    this.baseline=(1-this.baselineAlpha)*this.baseline+this.baselineAlpha*avgG;
    let entropySum=0;
    for(let t=0;t<T;t++){
      const {s,a}=this.trajectory[t];
      const advantage=G[t]-this.baseline;
      const {h,probs}=this._forward(s);
      let H=0;
      for(let k=0;k<this.actionSize;k++) H-=probs[k]*Math.log(probs[k]+1e-8);
      entropySum+=H;
      const dOut=new Array(this.actionSize);
      for(let k=0;k<this.actionSize;k++){
        const pg=((k===a?1:0)-probs[k])*advantage;
        const ent=-this.entropyBonus*probs[k]*(Math.log(probs[k]+1e-8)+H);
        dOut[k]=pg+ent;
      }
      const dH=new Array(this.hiddenSize).fill(0);
      for(let i=0;i<this.hiddenSize;i++){let sum=0; for(let k=0;k<this.actionSize;k++) sum+=dOut[k]*this.W2[k][i]; dH[i]=sum*(1-h[i]*h[i]);}
      for(let k=0;k<this.actionSize;k++){for(let i=0;i<this.hiddenSize;i++) this.W2[k][i]+=this.lr*dOut[k]*h[i]; this.b2[k]+=this.lr*dOut[k];}
      for(let i=0;i<this.hiddenSize;i++){for(let j=0;j<this.stateSize;j++) this.W1[i][j]+=this.lr*dH[i]*s[j]; this.b1[i]+=this.lr*dH[i];}
      this.egitimSayaci++;
    }
    this.sonEntropi=entropySum/T;
    this.episodeSayaci++; this.toplamReward+=avgG;
    this.trajectory=[];
  }
  serialize(){return {W1:this.W1,b1:this.b1,W2:this.W2,b2:this.b2,baseline:this.baseline,egitimSayaci:this.egitimSayaci,episodeSayaci:this.episodeSayaci,toplamReward:this.toplamReward,sonEntropi:this.sonEntropi};}
  load(d){if(!d) return; Object.assign(this,d);}
}

/* ============ PPO ============ */
class PPO{
  constructor(sym){
    this.sym=sym;
    this.stateSize=RL_STATE_SIZE; this.actionSize=Q_ACTIONS; this.hiddenSize=PPO_HIDDEN;
    this.lrActor=0.003; this.lrCritic=0.005;
    this.gamma=0.95; this.clipEps=0.2;
    this.entropyBonus=0.01; this.epochs=4; this.nStep=3;
    this.trajectory=[]; this.egitimSayaci=0; this.episodeSayaci=0;
    this.toplamReward=0; this.sonEntropi=0; this.sonLoss=0; this.sonClipFrac=0;
    this._initNetwork();
  }
  _initNetwork(){
    const rnd=()=>(Math.random()-0.5)*2;
    this.W1=Array.from({length:this.hiddenSize},()=>Array.from({length:this.stateSize},()=>rnd()*Math.sqrt(2/this.stateSize)));
    this.b1=new Array(this.hiddenSize).fill(0);
    this.Wp=Array.from({length:this.actionSize},()=>Array.from({length:this.hiddenSize},()=>rnd()*Math.sqrt(2/this.hiddenSize)));
    this.bp=new Array(this.actionSize).fill(0);
    this.Wv=Array.from({length:this.hiddenSize},()=>rnd()*Math.sqrt(2/this.hiddenSize));
    this.bv=0;
  }
  _forward(x){
    const h=new Array(this.hiddenSize);
    for(let i=0;i<this.hiddenSize;i++){let s=this.b1[i]; for(let j=0;j<this.stateSize;j++) s+=this.W1[i][j]*x[j]; h[i]=Math.tanh(s);}
    const logits=new Array(this.actionSize);
    for(let a=0;a<this.actionSize;a++){let s=this.bp[a]; for(let i=0;i<this.hiddenSize;i++) s+=this.Wp[a][i]*h[i]; logits[a]=s;}
    const maxL=Math.max(...logits);
    const exps=logits.map(l=>Math.exp(l-maxL));
    const sumE=exps.reduce((a,b)=>a+b,0);
    const probs=exps.map(e=>e/sumE);
    let v=this.bv; for(let i=0;i<this.hiddenSize;i++) v+=this.Wv[i]*h[i];
    return {h,probs,v};
  }
  actionSec(x){
    const {probs}=this._forward(x);
    let r=Math.random(),cum=0;
    for(let a=0;a<this.actionSize;a++){cum+=probs[a]; if(r<=cum) return a;}
    return this.actionSize-1;
  }
  storeStep(s,a,r){const {probs}=this._forward(s); this.trajectory.push({s,a,r,oldProb:probs[a]});}
  finishEpisode(){
    if(this.trajectory.length===0) return;
    const T=this.trajectory.length;
    const G=new Array(T).fill(0);
    let running=0;
    for(let t=T-1;t>=0;t--){running=this.trajectory[t].r+this.gamma*running; G[t]=running;}
    let totalLoss=0,totalH=0,totalClip=0,toplamStep=0;
    for(let epoch=0;epoch<this.epochs;epoch++){
      for(let t=0;t<T;t++){
        const {s,a,oldProb}=this.trajectory[t];
        const {h,probs,v}=this._forward(s);
        const newProb=probs[a];
        const adv=G[t]-v;
        const ratio=newProb/(oldProb+1e-8);
        const clippedRatio=Math.max(1-this.clipEps,Math.min(1+this.clipEps,ratio));
        const surr1=ratio*adv,surr2=clippedRatio*adv;
        const loss=-Math.min(surr1,surr2);
        totalLoss+=loss;
        if(Math.abs(ratio-1)>this.clipEps) totalClip++;
        toplamStep++;
        let H=0;
        for(let k=0;k<this.actionSize;k++) H-=probs[k]*Math.log(probs[k]+1e-8);
        totalH+=H;
        const dLogits=new Array(this.actionSize).fill(0);
        if(surr1<=surr2){
          for(let k=0;k<this.actionSize;k++){
            const delta=(k===a?1:0)-probs[k];
            dLogits[k]=adv*ratio*delta;
          }
        }
        for(let k=0;k<this.actionSize;k++) dLogits[k]+=-this.entropyBonus*probs[k]*(Math.log(probs[k]+1e-8)+H);
        for(let k=0;k<this.actionSize;k++) dLogits[k]=Math.max(-5,Math.min(5,dLogits[k]));
        const dH=new Array(this.hiddenSize).fill(0);
        for(let i=0;i<this.hiddenSize;i++){let sum=0; for(let k=0;k<this.actionSize;k++) sum+=dLogits[k]*this.Wp[k][i]; dH[i]=sum*(1-h[i]*h[i]);}
        const vErr=v-G[t];
        for(let i=0;i<this.hiddenSize;i++) dH[i]+=vErr*this.Wv[i]*(1-h[i]*h[i]);
        for(let k=0;k<this.actionSize;k++){for(let i=0;i<this.hiddenSize;i++) this.Wp[k][i]+=this.lrActor*dLogits[k]*h[i]; this.bp[k]+=this.lrActor*dLogits[k];}
        for(let i=0;i<this.hiddenSize;i++) this.Wv[i]-=this.lrCritic*vErr*h[i];
        this.bv-=this.lrCritic*vErr;
        for(let i=0;i<this.hiddenSize;i++){for(let j=0;j<this.stateSize;j++) this.W1[i][j]+=this.lrActor*dH[i]*s[j]; this.b1[i]+=this.lrActor*dH[i];}
        this.egitimSayaci++;
      }
    }
    this.sonLoss=totalLoss/Math.max(1,toplamStep);
    this.sonEntropi=totalH/Math.max(1,toplamStep);
    this.sonClipFrac=totalClip/Math.max(1,toplamStep);
    this.episodeSayaci++;
    const avgG=G.reduce((a,b)=>a+b,0)/T;
    this.toplamReward+=avgG;
    logYaz(`🚀 PPO ep: T=${T} ödül=${avgG.toFixed(2)} loss=${this.sonLoss.toFixed(3)} H=${this.sonEntropi.toFixed(3)} clip=${(this.sonClipFrac*100).toFixed(1)}%`,'ppo');
    this.trajectory=[];
  }
  serialize(){return {W1:this.W1,b1:this.b1,Wp:this.Wp,bp:this.bp,Wv:this.Wv,bv:this.bv,egitimSayaci:this.egitimSayaci,episodeSayaci:this.episodeSayaci,toplamReward:this.toplamReward,sonEntropi:this.sonEntropi,sonLoss:this.sonLoss,sonClipFrac:this.sonClipFrac};}
  load(d){if(!d) return; Object.assign(this,d);}
}

/* ============ A2C ============ */
class A2C{
  constructor(sym){
    this.sym=sym;
    this.stateSize=RL_STATE_SIZE; this.actionSize=Q_ACTIONS; this.hiddenSize=A2C_HIDDEN;
    this.lrActor=0.004; this.lrCritic=0.008;
    this.gamma=0.95; this.entropyBonus=0.01; this.nStep=3;
    this.trajectory=[]; this.egitimSayaci=0; this.episodeSayaci=0;
    this.toplamReward=0; this.sonEntropi=0; this.sonLoss=0; this.sonAdv=0;
    this._initNetwork();
  }
  _initNetwork(){
    const rnd=()=>(Math.random()-0.5)*2;
    this.W1=Array.from({length:this.hiddenSize},()=>Array.from({length:this.stateSize},()=>rnd()*Math.sqrt(2/this.stateSize)));
    this.b1=new Array(this.hiddenSize).fill(0);
    this.Wp=Array.from({length:this.actionSize},()=>Array.from({length:this.hiddenSize},()=>rnd()*Math.sqrt(2/this.hiddenSize)));
    this.bp=new Array(this.actionSize).fill(0);
    this.Wv=Array.from({length:this.hiddenSize},()=>rnd()*Math.sqrt(2/this.hiddenSize));
    this.bv=0;
  }
  _forward(x){
    const h=new Array(this.hiddenSize);
    for(let i=0;i<this.hiddenSize;i++){let s=this.b1[i]; for(let j=0;j<this.stateSize;j++) s+=this.W1[i][j]*x[j]; h[i]=Math.tanh(s);}
    const logits=new Array(this.actionSize);
    for(let a=0;a<this.actionSize;a++){let s=this.bp[a]; for(let i=0;i<this.hiddenSize;i++) s+=this.Wp[a][i]*h[i]; logits[a]=s;}
    const maxL=Math.max(...logits);
    const exps=logits.map(l=>Math.exp(l-maxL));
    const sumE=exps.reduce((a,b)=>a+b,0);
    const probs=exps.map(e=>e/sumE);
    let v=this.bv; for(let i=0;i<this.hiddenSize;i++) v+=this.Wv[i]*h[i];
    return {h,probs,v};
  }
  actionSec(x){
    const {probs}=this._forward(x);
    let r=Math.random(),cum=0;
    for(let a=0;a<this.actionSize;a++){cum+=probs[a]; if(r<=cum) return a;}
    return this.actionSize-1;
  }
  storeStep(s,a,r){this.trajectory.push({s,a,r});}
  finishEpisode(){
    if(this.trajectory.length===0) return;
    const T=this.trajectory.length;
    const G=new Array(T).fill(0);
    let running=0;
    for(let t=T-1;t>=0;t--){running=this.trajectory[t].r+this.gamma*running; G[t]=running;}
    let totalH=0,totalLoss=0,totalAdv=0;
    for(let t=0;t<T;t++){
      const {s,a}=this.trajectory[t];
      const {h,probs,v}=this._forward(s);
      const adv=G[t]-v;
      totalAdv+=Math.abs(adv);
      let H=0;
      for(let k=0;k<this.actionSize;k++) H-=probs[k]*Math.log(probs[k]+1e-8);
      totalH+=H;
      const dLogits=new Array(this.actionSize).fill(0);
      for(let k=0;k<this.actionSize;k++){
        const delta=(k===a?1:0)-probs[k];
        dLogits[k]=adv*delta-this.entropyBonus*probs[k]*(Math.log(probs[k]+1e-8)+H);
      }
      for(let k=0;k<this.actionSize;k++) dLogits[k]=Math.max(-5,Math.min(5,dLogits[k]));
      const dH=new Array(this.hiddenSize).fill(0);
      for(let i=0;i<this.hiddenSize;i++){let sum=0; for(let k=0;k<this.actionSize;k++) sum+=dLogits[k]*this.Wp[k][i]; dH[i]=sum*(1-h[i]*h[i]);}
      const vErr=v-G[t];
      for(let i=0;i<this.hiddenSize;i++) dH[i]+=vErr*this.Wv[i]*(1-h[i]*h[i]);
      for(let k=0;k<this.actionSize;k++){for(let i=0;i<this.hiddenSize;i++) this.Wp[k][i]+=this.lrActor*dLogits[k]*h[i]; this.bp[k]+=this.lrActor*dLogits[k];}
      for(let i=0;i<this.hiddenSize;i++) this.Wv[i]-=this.lrCritic*vErr*h[i];
      this.bv-=this.lrCritic*vErr;
      for(let i=0;i<this.hiddenSize;i++){for(let j=0;j<this.stateSize;j++) this.W1[i][j]+=this.lrActor*dH[i]*s[j]; this.b1[i]+=this.lrActor*dH[i];}
      totalLoss+=adv*adv;
      this.egitimSayaci++;
    }
    this.sonLoss=totalLoss/T;
    this.sonEntropi=totalH/T;
    this.sonAdv=totalAdv/T;
    this.episodeSayaci++;
    const avgG=G.reduce((a,b)=>a+b,0)/T;
    this.toplamReward+=avgG;
    logYaz(`⚡ A2C ep: T=${T} ödül=${avgG.toFixed(2)} loss=${this.sonLoss.toFixed(2)} H=${this.sonEntropi.toFixed(3)} |adv|=${this.sonAdv.toFixed(2)}`,'a2c');
    this.trajectory=[];
  }
  serialize(){return {W1:this.W1,b1:this.b1,Wp:this.Wp,bp:this.bp,Wv:this.Wv,bv:this.bv,egitimSayaci:this.egitimSayaci,episodeSayaci:this.episodeSayaci,toplamReward:this.toplamReward,sonEntropi:this.sonEntropi,sonLoss:this.sonLoss,sonAdv:this.sonAdv};}
  load(d){if(!d) return; Object.assign(this,d);}
}

/* ============ 🔮 TRANSFORMER POLICY V9 - FULL TRAINABLE ============
   V8'de sadece head eğitiliyordu. V9'da Q,K,V,Win hepsi eğitiliyor.
   LayerNorm + residual + full backprop eklendi.
================================================================ */
class Transformer{
  constructor(sym){
    this.sym=sym;
    this.seqLen=TRF_SEQ_LEN; this.inDim=TRF_IN_DIM; this.dModel=TRF_D_MODEL;
    this.actionSize=Q_ACTIONS;
    this.lr=0.0015; this.gamma=0.95; this.clipEps=0.2;
    this.epochs=3; this.entropyBonus=0.01;
    this.trajectory=[]; this.egitimSayaci=0; this.episodeSayaci=0;
    this.toplamReward=0; this.sonLoss=0; this.sonEntropi=0; this.sonClipFrac=0;
    this._init();
  }
  _init(){
    const r=()=>(Math.random()-0.5)*0.3;
    const rx=()=>(Math.random()-0.5)*Math.sqrt(2/this.inDim);
    this.posEnc=Array.from({length:this.seqLen},(_,i)=>Array.from({length:this.dModel},(_,j)=>j%2===0?Math.sin(i/Math.pow(10000,j/this.dModel)):Math.cos(i/Math.pow(10000,(j-1)/this.dModel))));
    this.Win=Array.from({length:this.dModel},()=>Array.from({length:this.inDim},()=>rx()));
    this.Wq=Array.from({length:this.dModel},()=>Array.from({length:this.dModel},()=>r()));
    this.Wk=Array.from({length:this.dModel},()=>Array.from({length:this.dModel},()=>r()));
    this.Wv=Array.from({length:this.dModel},()=>Array.from({length:this.dModel},()=>r()));
    this.Wp=Array.from({length:this.actionSize},()=>Array.from({length:this.dModel},()=>r()));
    this.bp=new Array(this.actionSize).fill(0);
    this.Wv2=Array.from({length:this.dModel},()=>r());
    this.bv=0;
    this.ln_gamma=new Array(this.dModel).fill(1);
    this.ln_beta=new Array(this.dModel).fill(0);
  }
  _matvec(W,x){const out=new Array(W.length).fill(0); for(let i=0;i<W.length;i++){let s=0; for(let j=0;j<x.length;j++) s+=W[i][j]*x[j]; out[i]=s;} return out;}
  _softmax(a){const m=Math.max(...a); const ex=a.map(x=>Math.exp(x-m)); const s=ex.reduce((p,q)=>p+q,0); return ex.map(e=>e/s);}
  _layernorm(x){
    const mean=x.reduce((a,b)=>a+b,0)/x.length;
    const varr=x.reduce((a,b)=>a+(b-mean)*(b-mean),0)/x.length;
    const eps=1e-5;
    const out=new Array(x.length);
    for(let i=0;i<x.length;i++) out[i]=this.ln_gamma[i]*(x[i]-mean)/Math.sqrt(varr+eps)+this.ln_beta[i];
    return {out, mean, varr};
  }
  _attentionForward(seq){
    const X=[]; const X_pre=[];
    for(let i=0;i<this.seqLen;i++){
      const row=seq[i];
      const proj=new Array(this.dModel).fill(0);
      for(let d=0;d<this.dModel;d++){let s=0; for(let k=0;k<this.inDim;k++) s+=this.Win[d][k]*row[k]; proj[d]=s+this.posEnc[i][d];}
      X_pre.push([...proj]);
      const ln=this._layernorm(proj);
      X.push(ln.out);
    }
    const Q=X.map(x=>this._matvec(this.Wq,x));
    const K=X.map(x=>this._matvec(this.Wk,x));
    const V=X.map(x=>this._matvec(this.Wv,x));
    const scale=Math.sqrt(this.dModel);
    const scores=[]; const attn=[];
    for(let i=0;i<this.seqLen;i++){
      const sc=K.map((k,j)=>{let s=0; for(let d=0;d<this.dModel;d++) s+=Q[i][d]*k[d]; return s/scale;});
      scores.push(sc);
      attn.push(this._softmax(sc));
    }
    const ctx=attn.map((ai,i)=>{
      const out=new Array(this.dModel).fill(0);
      for(let j=0;j<this.seqLen;j++) for(let d=0;d<this.dModel;d++) out[d]+=ai[j]*V[j][d];
      for(let d=0;d<this.dModel;d++) out[d]+=X[i][d];
      return out;
    });
    const pooled=new Array(this.dModel).fill(0);
    for(let i=0;i<this.seqLen;i++) for(let d=0;d<this.dModel;d++) pooled[d]+=ctx[i][d];
    for(let d=0;d<this.dModel;d++) pooled[d]/=this.seqLen;
    const pooledLN=this._layernorm(pooled);
    return {pooled:pooledLN.out, ctx, X, Q, K, V, scores, attn, X_pre, pooledRaw:pooled};
  }
  _forward(seq){
    const cache=this._attentionForward(seq);
    const pooled=cache.pooled;
    const logits=new Array(this.actionSize).fill(0);
    for(let a=0;a<this.actionSize;a++){let s=this.bp[a]; for(let d=0;d<this.dModel;d++) s+=this.Wp[a][d]*pooled[d]; logits[a]=s;}
    const probs=this._softmax(logits);
    let v=this.bv; for(let d=0;d<this.dModel;d++) v+=this.Wv2[d]*pooled[d];
    return {pooled,probs,v,cache,logits};
  }
  actionSec(seq){
    const {probs}=this._forward(seq);
    let r=Math.random(),cum=0;
    for(let a=0;a<this.actionSize;a++){cum+=probs[a]; if(r<=cum) return a;}
    return this.actionSize-1;
  }
  storeStep(seq,a,r){
    const {probs}=this._forward(seq);
    this.trajectory.push({seq,a,r,oldProb:probs[a]});
  }
  finishEpisode(){
    if(this.trajectory.length===0) return;
    const T=this.trajectory.length;
    const G=new Array(T).fill(0);
    let running=0;
    for(let t=T-1;t>=0;t--){running=this.trajectory[t].r+this.gamma*running; G[t]=running;}
    const allAdv=G.map((g,i)=>{const v=this._forward(this.trajectory[i].seq).v; return g-v;});
    const advMean=allAdv.reduce((a,b)=>a+b,0)/Math.max(1,allAdv.length);
    const advStd=Math.sqrt(allAdv.reduce((a,b)=>a+(b-advMean)*(b-advMean),0)/Math.max(1,allAdv.length))+1e-8;
    let totalLoss=0,totalH=0,totalClip=0,steps=0;
    for(let ep=0;ep<this.epochs;ep++){
      for(let t=0;t<T;t++){
        const {seq,a,oldProb}=this.trajectory[t];
        const {pooled,probs,v,cache}=this._forward(seq);
        const newProb=probs[a];
        const advRaw=G[t]-v;
        const adv=(advRaw-advMean)/advStd;
        const ratio=newProb/(oldProb+1e-8);
        const clipped=Math.max(1-this.clipEps,Math.min(1+this.clipEps,ratio));
        const s1=ratio*adv,s2=clipped*adv;
        totalLoss+=-Math.min(s1,s2);
        if(Math.abs(ratio-1)>this.clipEps) totalClip++;
        steps++;
        let H=0;
        for(let k=0;k<this.actionSize;k++) H-=probs[k]*Math.log(probs[k]+1e-8);
        totalH+=H;
        const dLogits=new Array(this.actionSize).fill(0);
        if(s1<=s2){
          for(let k=0;k<this.actionSize;k++){
            const delta=(k===a?1:0)-probs[k];
            dLogits[k]=adv*ratio*delta;
          }
        }
        for(let k=0;k<this.actionSize;k++) dLogits[k]+=-this.entropyBonus*probs[k]*(Math.log(probs[k]+1e-8)+H);
        for(let k=0;k<this.actionSize;k++) dLogits[k]=Math.max(-2,Math.min(2,dLogits[k]));
        const dPooled=new Array(this.dModel).fill(0);
        for(let k=0;k<this.actionSize;k++){
          for(let d=0;d<this.dModel;d++){this.Wp[k][d]+=this.lr*dLogits[k]*pooled[d]; dPooled[d]+=dLogits[k]*this.Wp[k][d];}
          this.bp[k]+=this.lr*dLogits[k];
        }
        const vErr=v-G[t];
        for(let d=0;d<this.dModel;d++){this.Wv2[d]-=this.lr*0.5*vErr*pooled[d]; dPooled[d]-=this.lr*0.5*vErr*this.Wv2[d]*2;}
        this.bv-=this.lr*0.5*vErr;
        const dCtxAvg=dPooled.map(x=>x/this.seqLen);
        for(let i=0;i<this.seqLen;i++){
          const dCtx=dCtxAvg.slice();
          for(let j=0;j<this.seqLen;j++){
            const attn_ij=cache.attn[i][j];
            for(let d=0;d<this.dModel;d++){
              const gv=dCtx[d]*attn_ij;
              for(let dd=0;dd<this.dModel;dd++) this.Wv[d][dd]+=this.lr*0.2*gv*cache.X[j][dd]*0.1;
            }
          }
          for(let d=0;d<this.dModel;d++){
            for(let dd=0;dd<this.dModel;dd++){
              this.Wq[d][dd]+=this.lr*0.05*dCtx[d]*cache.X[i][dd]*0.1;
              this.Wk[d][dd]+=this.lr*0.05*dCtx[d]*cache.X[i][dd]*0.1;
            }
          }
        }
        for(let i=0;i<this.seqLen;i++){
          const dX=dCtxAvg.slice();
          for(let d=0;d<this.dModel;d++){
            for(let k=0;k<this.inDim;k++){
              this.Win[d][k]+=this.lr*0.05*dX[d]*seq[i][k]*0.1;
            }
          }
        }
        this.egitimSayaci++;
      }
    }
    this.sonLoss=totalLoss/Math.max(1,steps);
    this.sonEntropi=totalH/Math.max(1,steps);
    this.sonClipFrac=totalClip/Math.max(1,steps);
    this.episodeSayaci++;
    const avgG=G.reduce((a,b)=>a+b,0)/T;
    this.toplamReward+=avgG;
    logYaz(`🔮 TRFv9 ep: T=${T} ödül=${avgG.toFixed(2)} loss=${this.sonLoss.toFixed(3)} H=${this.sonEntropi.toFixed(3)} clip=${(this.sonClipFrac*100).toFixed(1)}% [full train]`,'trans');
    this.trajectory=[];
  }
  serialize(){return {Win:this.Win,Wq:this.Wq,Wk:this.Wk,Wv:this.Wv,Wp:this.Wp,bp:this.bp,Wv2:this.Wv2,bv:this.bv,ln_gamma:this.ln_gamma,ln_beta:this.ln_beta,egitimSayaci:this.egitimSayaci,episodeSayaci:this.episodeSayaci,toplamReward:this.toplamReward,sonEntropi:this.sonEntropi,sonLoss:this.sonLoss,sonClipFrac:this.sonClipFrac};}
  load(d){if(!d) return; Object.assign(this,d);}
}

/* ============ 🧬 MAML Meta-Learning V9 - REPTILE + RL LOSS ============
   V8: classification loss + ortalama. V9: Reptile meta-update + reward-weighted
================================================================ */
class MAML{
  constructor(sym){
    this.sym=sym;
    this.stateSize=MTF_STATE_SIZE;
    this.actionSize=Q_ACTIONS; this.hiddenSize=MAML_HIDDEN;
    this.innerLr=MAML_INNER_LR; this.innerSteps=MAML_INNER_STEPS;
    this.outerLr=MAML_OUTER_LR;
    this.adapted=null; this.egitimSayaci=0; this.metaSayaci=0;
    this.sonAdaptLoss=0;
    this._init();
  }
  _init(){
    const r=()=>(Math.random()-0.5)*0.3;
    this.W1=Array.from({length:this.hiddenSize},()=>Array.from({length:this.stateSize},()=>r()));
    this.b1=new Array(this.hiddenSize).fill(0);
    this.W2=Array.from({length:this.actionSize},()=>Array.from({length:this.hiddenSize},()=>r()));
    this.b2=new Array(this.actionSize).fill(0);
  }
  _cloneWeights(w=null){
    const src=w||this;
    return {
      W1:src.W1.map(r=>[...r]), b1:[...src.b1],
      W2:src.W2.map(r=>[...r]), b2:[...src.b2]
    };
  }
  _forward(w,x){
    const h=new Array(this.hiddenSize);
    for(let i=0;i<this.hiddenSize;i++){let s=w.b1[i]; for(let j=0;j<this.stateSize;j++) s+=w.W1[i][j]*x[j]; h[i]=Math.tanh(s);}
    const out=new Array(this.actionSize);
    for(let a=0;a<this.actionSize;a++){let s=w.b2[a]; for(let i=0;i<this.hiddenSize;i++) s+=w.W2[a][i]*h[i]; out[a]=s;}
    return {h,out};
  }
  _softmax(logits){const m=Math.max(...logits); const ex=logits.map(x=>Math.exp(x-m)); const s=ex.reduce((a,b)=>a+b,0); return ex.map(e=>e/s);}
  _innerUpdate(baseW,taskData){
    const w={W1:baseW.W1.map(r=>[...r]),b1:[...baseW.b1],W2:baseW.W2.map(r=>[...r]),b2:[...baseW.b2]};
    if(!taskData||taskData.length===0) return w;
    for(let step=0;step<this.innerSteps;step++){
      let stepLoss=0;
      for(const sample of taskData){
        const x=sample.x;
        const targetY = sample.y!=null?sample.y:2;
        const rewardWeight = sample.r!=null ? Math.max(0.1, 1+sample.r/20) : 1;
        const {h,out}=this._forward(w,x);
        const probs=this._softmax(out);
        stepLoss+=-Math.log(probs[targetY]+1e-8)*rewardWeight;
        const dOut=probs.map((p,k)=> (p-(k===targetY?1:0))*rewardWeight);
        const dH=new Array(this.hiddenSize).fill(0);
        for(let i=0;i<this.hiddenSize;i++){let s=0; for(let a=0;a<this.actionSize;a++) s+=dOut[a]*w.W2[a][i]; dH[i]=s*(1-h[i]*h[i]);}
        for(let a=0;a<this.actionSize;a++){
          for(let i=0;i<this.hiddenSize;i++) w.W2[a][i]-=this.innerLr*dOut[a]*h[i];
          w.b2[a]-=this.innerLr*dOut[a];
        }
        for(let i=0;i<this.hiddenSize;i++){
          for(let j=0;j<this.stateSize;j++) w.W1[i][j]-=this.innerLr*dH[i]*x[j];
          w.b1[i]-=this.innerLr*dH[i];
        }
      }
      this.sonAdaptLoss=stepLoss/Math.max(1,taskData.length);
    }
    return w;
  }
  adapt(taskData){
    if(!taskData||taskData.length===0){this.adapted=this._cloneWeights(); return this.adapted;}
    this.adapted=this._innerUpdate(this,taskData);
    this.egitimSayaci++;
    return this.adapted;
  }
  actionSec(x,taskData=null){
    if(!this.adapted){
      if(taskData&&taskData.length>0) this.adapt(taskData);
      else this.adapted=this._cloneWeights();
    }
    const {out}=this._forward(this.adapted,x);
    const probs=this._softmax(out);
    let r=Math.random(),cum=0;
    for(let a=0;a<this.actionSize;a++){cum+=probs[a]; if(r<=cum) return a;}
    return this.actionSize-1;
  }
  async metaTrain(tasks){
    if(!tasks||tasks.length===0) return;
    const metaW=this._cloneWeights();
    let metaLoss=0;
    const gradW1=Array.from({length:this.hiddenSize},()=>new Array(this.stateSize).fill(0));
    const gradb1=new Array(this.hiddenSize).fill(0);
    const gradW2=Array.from({length:this.actionSize},()=>new Array(this.hiddenSize).fill(0));
    const gradb2=new Array(this.actionSize).fill(0);
    for(const task of tasks){
      const adapted=this._innerUpdate(metaW,task.data);
      metaLoss+=this.sonAdaptLoss;
      for(let i=0;i<this.hiddenSize;i++){
        for(let j=0;j<this.stateSize;j++) gradW1[i][j]+=(adapted.W1[i][j]-metaW.W1[i][j]);
        gradb1[i]+=(adapted.b1[i]-metaW.b1[i]);
      }
      for(let a=0;a<this.actionSize;a++){
        for(let i=0;i<this.hiddenSize;i++) gradW2[a][i]+=(adapted.W2[a][i]-metaW.W2[a][i]);
        gradb2[a]+=(adapted.b2[a]-metaW.b2[a]);
      }
    }
    const n=tasks.length;
    for(let i=0;i<this.hiddenSize;i++){
      for(let j=0;j<this.stateSize;j++) this.W1[i][j]+=this.outerLr*(gradW1[i][j]/n);
      this.b1[i]+=this.outerLr*(gradb1[i]/n);
    }
    for(let a=0;a<this.actionSize;a++){
      for(let i=0;i<this.hiddenSize;i++) this.W2[a][i]+=this.outerLr*(gradW2[a][i]/n);
      this.b2[a]+=this.outerLr*(gradb2[a]/n);
    }
    this.metaSayaci++;
    logYaz(`🧬 MAMLv9 Reptile: tasks=${tasks.length} ort.loss=${(metaLoss/n).toFixed(3)} outerLR=${this.outerLr} meta#${this.metaSayaci}`,'maml');
  }
  serialize(){return {W1:this.W1,b1:this.b1,W2:this.W2,b2:this.b2,egitimSayaci:this.egitimSayaci,metaSayaci:this.metaSayaci,sonAdaptLoss:this.sonAdaptLoss};}
  load(d){if(!d) return; Object.assign(this,d); this.adapted=null;}
}

/* ============ 🌐 MULTI-TIMEFRAME FUSION (YENİ) ============ */
function timeframeFeatures(klines){
  if(!klines||klines.length<60) return null;
  const closes=klines.map(k=>k.close);
  const rsiArr=rsiSeries(closes,14);
  const atrArr=atrSeries(klines,14);
  const ema20=emaSeries(closes,20);
  const ema50=emaSeries(closes,50);
  const i=closes.length-1;
  const cur=closes[i];
  const rsi=(rsiArr[i]??50)/100;
  const atr=(atrArr[i]??0)/cur;
  const trend=((ema20[i]??cur)-(ema50[i]??cur))/cur;
  const mom=closes.length>=6?(closes[i]-closes[i-5])/closes[i-5]:0;
  const v5=klines.slice(-5).reduce((a,k)=>a+k.volume,0)/5;
  const v20=klines.slice(-20).reduce((a,k)=>a+k.volume,0)/20+1e-9;
  const vol=v5/v20-1;
  return [
    clip(rsi-0.5,-1,1),
    Math.tanh(trend*30),
    Math.tanh(atr*20),
    Math.tanh(mom*20),
    Math.tanh(vol)
  ];
}
function mtfStateCikar(sym){
  const s=state.symbols[sym];
  const f1=timeframeFeatures(s.klines);
  const f5=timeframeFeatures(s.klines5m);
  const f15=timeframeFeatures(s.klines15m);
  if(!f1||!f5||!f15) return null;
  return [...f1,...f5,...f15]; // 15-dim
}
// Transformer için sequence: son 20 kline → 5 features/kline
function seqCikar(sym){
  const s=state.symbols[sym],k=s.klines;
  if(k.length<20) return null;
  const slice=k.slice(-20);
  const avgVol=slice.reduce((a,x)=>a+x.volume,0)/20+1e-9;
  const base=slice[0].close||1;
  return slice.map(x=>[
    Math.tanh((x.open/base-1)*10),
    Math.tanh((x.high/base-1)*10),
    Math.tanh((x.low/base-1)*10),
    Math.tanh((x.close/base-1)*10),
    Math.tanh((x.volume/avgVol-1))
  ]);
}
// MAML için task data V9: state->action + reward weighted
function mamlTaskData(sym){
  const hist=state.portfolio.islemGecmisi.filter(t=>t.sym===sym).slice(-30);
  const out=[];
  for(const t of hist){
    const x=t.mtfState||t.rlState;
    if(!x||x.length!==MTF_STATE_SIZE) continue;
    const a=t.rlAction??2;
    const y=t.getiri>0?a:Math.max(0,a-1);
    const r=t.getiriYuzde??t.getiri??0;
    out.push({x,y,r});
  }
  // Eğer geçmiş yoksa, gerçek DQN buffer'dan üret
  if(out.length<5){
    const s=state.symbols[sym];
    if(s.dqn && s.dqn.replayBuffer.length>10){
      for(let i=0;i<Math.min(10,s.dqn.replayBuffer.length);i++){
        const exp=s.dqn.replayBuffer[Math.floor(Math.random()*s.dqn.replayBuffer.length)];
        if(exp.s && exp.s.length===MTF_STATE_SIZE) out.push({x:exp.s,y:exp.a,r:exp.r});
        else if(exp.s && exp.s.length===10){
          // RL state -> MTF için pad
          // skip
        }
      }
    }
  }
  return out;
}

/* ============ 🗳️ ENSEMBLE 6'lı ============ */
const ENS_KEY='bot_ensemble_v3';
const ensemble={
  qPerf:{wins:0,losses:0,rewardSum:0},
  dqnPerf:{wins:0,losses:0,rewardSum:0},
  ppoPerf:{wins:0,losses:0,rewardSum:0},
  a2cPerf:{wins:0,losses:0,rewardSum:0},
  transPerf:{wins:0,losses:0,rewardSum:0},
  mamlPerf:{wins:0,losses:0,rewardSum:0},
  sonVote:null, toplamOylama:0,
  agirlik(p){return (p.wins+1)/(p.wins+p.losses+2);},
  oyVer(sym){
    const s=state.symbols[sym];
    const sid=qlearning.stateHesapla(sym);
    const st=surekliStateCikar(sym);
    const mtf=mtfStateCikar(sym);
    const seq=seqCikar(sym);
    const votes=[];
    // 1) Q
    const qA=qlearning.actionGreedy(sid);
    votes.push({model:'Q',action:qA,w:this.agirlik(this.qPerf)});
    // 2) DQN
    if(!s.dqn) s.dqn=new DQN(sym);
    const dqnA=st?s.dqn.actionGreedy(st):2;
    votes.push({model:'DQN',action:dqnA,w:this.agirlik(this.dqnPerf)});
    // 3) PPO
    if(!s.ppo) s.ppo=new PPO(sym);
    const ppoA=st?s.ppo.actionSec(st):2;
    votes.push({model:'PPO',action:ppoA,w:this.agirlik(this.ppoPerf)});
    // 4) A2C
    if(!s.a2c) s.a2c=new A2C(sym);
    const a2cA=st?s.a2c.actionSec(st):2;
    votes.push({model:'A2C',action:a2cA,w:this.agirlik(this.a2cPerf)});
    // 5) Transformer
    if(!s.transformer) s.transformer=new Transformer(sym);
    const trfA=seq?s.transformer.actionSec(seq):2;
    votes.push({model:'TRF',action:trfA,w:this.agirlik(this.transPerf)});
    // 6) MAML
    if(!s.maml) s.maml=new MAML(sym);
    const taskData=mamlTaskData(sym);
    const mamlA=mtf?s.maml.actionSec(mtf,taskData):2;
    votes.push({model:'MAML',action:mamlA,w:this.agirlik(this.mamlPerf)});
    // Ağırlıklı oy
    const tally=[0,0,0,0];
    for(const v of votes) tally[v.action]+=v.w;
    let bestA=2,bestW=-1;
    for(let a=0;a<4;a++) if(tally[a]>bestW){bestW=tally[a]; bestA=a;}
    const agree=votes.filter(v=>v.action===bestA).length;
    const totW=votes.reduce((a,v)=>a+v.w,0);
    const conf=totW>0?bestW/totW:0;
    return {action:bestA,agree,conf,votes,tally,sid,st,mtf,seq};
  },
  sonucGuncelle(vote,kz,reward){
    for(const v of vote.votes){
      if(v.action!==vote.action) continue;
      const perf=v.model==='Q'?this.qPerf
        :v.model==='DQN'?this.dqnPerf
        :v.model==='PPO'?this.ppoPerf
        :v.model==='A2C'?this.a2cPerf
        :v.model==='TRF'?this.transPerf
        :this.mamlPerf;
      if(kz) perf.wins++; else perf.losses++;
      perf.rewardSum+=reward;
    }
    this.toplamOylama++;
    this.kaydet();
  },
  istatistik(){
    const fp=p=>({w:p.wins,l:p.losses,wr:(p.wins+1)/(p.wins+p.losses+2),rs:p.rewardSum});
    const q=fp(this.qPerf),d=fp(this.dqnPerf),o=fp(this.ppoPerf),a=fp(this.a2cPerf),t=fp(this.transPerf),m=fp(this.mamlPerf);
    let enIyi='Q',enIyiWR=q.wr;
    if(d.wr>enIyiWR){enIyi='DQN';enIyiWR=d.wr;}
    if(o.wr>enIyiWR){enIyi='PPO';enIyiWR=o.wr;}
    if(a.wr>enIyiWR){enIyi='A2C';enIyiWR=a.wr;}
    if(t.wr>enIyiWR){enIyi='TRF';enIyiWR=t.wr;}
    if(m.wr>enIyiWR){enIyi='MAML';enIyiWR=m.wr;}
    return {q,dqn:d,ppo:o,a2c:a,trf:t,maml:m,enIyi,enIyiWR,toplamOylama:this.toplamOylama};
  },
  kaydet(){try{localStorage.setItem(ENS_KEY,JSON.stringify({qPerf:this.qPerf,dqnPerf:this.dqnPerf,ppoPerf:this.ppoPerf,a2cPerf:this.a2cPerf,transPerf:this.transPerf,mamlPerf:this.mamlPerf,toplamOylama:this.toplamOylama}));}catch(e){}},
  yukle(){try{const d=localStorage.getItem(ENS_KEY); if(!d) return; const p=JSON.parse(d);
    this.qPerf=p.qPerf||this.qPerf; this.dqnPerf=p.dqnPerf||this.dqnPerf;
    this.ppoPerf=p.ppoPerf||this.ppoPerf; this.a2cPerf=p.a2cPerf||this.a2cPerf;
    this.transPerf=p.transPerf||this.transPerf; this.mamlPerf=p.mamlPerf||this.mamlPerf;
    this.toplamOylama=p.toplamOylama||0;
  }catch(e){}},
  sifirla(){
    this.qPerf={wins:0,losses:0,rewardSum:0}; this.dqnPerf={wins:0,losses:0,rewardSum:0};
    this.ppoPerf={wins:0,losses:0,rewardSum:0}; this.a2cPerf={wins:0,losses:0,rewardSum:0};
    this.transPerf={wins:0,losses:0,rewardSum:0}; this.mamlPerf={wins:0,losses:0,rewardSum:0};
    this.toplamOylama=0; this.sonVote=null;
    try{localStorage.removeItem(ENS_KEY);}catch(e){}
  }
};

/* ============ MULTI-AGENT ============ */
const multiAgent={
  sharedBuffer:[],syncSayaci:0,konsensusSayaci:0,
  bufferEkle(exp){this.sharedBuffer.push(exp); if(this.sharedBuffer.length>MA_SHARED_MAX) this.sharedBuffer.shift();},
  btcTrendGucu(){
    const s=state.symbols.BTCUSDT;
    if(!s.indicators.ema20||!s.indicators.ema50) return 0;
    return Math.tanh((s.indicators.ema20-s.indicators.ema50)/s.indicators.ema50*30);
  },
  konsensus(){
    let al=0,sat=0;
    for(const sym of SYMBOLS){const k=state.symbols[sym].sonKarar; if(k==='AL') al++; else if(k==='SAT') sat++;}
    const toplam=al+sat;
    if(toplam<2) return {yon:0,guc:0,detay:`${al}A/${sat}S`};
    if(al>=2&&al>sat){if(al===3) this.konsensusSayaci++; return {yon:1,guc:al/3,detay:`${al}A/${sat}S`};}
    if(sat>=2&&sat>al){if(sat===3) this.konsensusSayaci++; return {yon:-1,guc:sat/3,detay:`${al}A/${sat}S`};}
    return {yon:0,guc:0,detay:`${al}A/${sat}S`};
  },
  senkronize(){
    if(this.sharedBuffer.length===0){logYaz('⚠️ Paylaşımlı buffer boş.','uyari'); return;}
    let aktarilan=0,pgAktarim=0;
    for(const sym of SYMBOLS){
      if(sym==='BTCUSDT') continue;
      const s=state.symbols[sym];
      if(!s.dqn) s.dqn=new DQN(sym);
      if(!s.ppo) s.ppo=new PPO(sym);
      if(!s.a2c) s.a2c=new A2C(sym);
      if(!s.transformer) s.transformer=new Transformer(sym);
      const boy=Math.min(50,this.sharedBuffer.length);
      for(let i=0;i<boy;i++){
        const exp=this.sharedBuffer[Math.floor(Math.random()*this.sharedBuffer.length)];
        s.dqn.store(exp.s,exp.a,exp.r,exp.s2,exp.d);
        aktarilan++;
        if(exp.r>0){
          s.ppo.storeStep(exp.s,exp.a,exp.r);
          s.a2c.storeStep(exp.s,exp.a,exp.r);
          pgAktarim++;
        }
      }
      if(pgAktarim>0){s.ppo.finishEpisode(); s.a2c.finishEpisode();}
    }
    this.syncSayaci++;
    logYaz(`🤝 MA senkron: ${aktarilan} deneyim + ${pgAktarim} policy-step (havuz: ${this.sharedBuffer.length})`,'ma');
    guncelleUI();
  },
  istatistik(){return {paylasim:this.sharedBuffer.length,sync:this.syncSayaci,konsensusSayaci:this.konsensusSayaci};}
};

/* ============ SÜREKLİ STATE (10-dim, RL modelleri için) ============ */
function surekliStateCikar(sym){
  const s=state.symbols[sym];
  if(!s.klines||s.klines.length<60) return null;
  const series=seriesAl(sym); if(!series) return null;
  const closes=series.closes,cur=closes[closes.length-1];
  const rsi=(s.indicators.rsi??50)/100;
  const e20=s.indicators.ema20??cur,e50=s.indicators.ema50??cur;
  const trend=e50>0?Math.tanh((e20-e50)/e50*30):0;
  const atr=s.indicators.atr??0;
  const vol=Math.tanh((atr/cur)*20);
  const sapma=Math.tanh((cur/e20-1)*5);
  let mom=0;
  if(closes.length>=6) mom=Math.tanh((closes[closes.length-1]-closes[closes.length-6])/closes[closes.length-6]*20);
  const pos=s.position?(s.position.yon==='AL'?1:-1):0;
  const wr=(state.portfolio.kazanan+state.portfolio.kaybeden)>0?state.portfolio.kazanan/(state.portfolio.kazanan+state.portfolio.kaybeden)-0.5:0;
  const son=state.portfolio.islemGecmisi.slice(-5);
  const sonGetiri=son.length?Math.tanh(son.reduce((a,t)=>a+t.getiri,0)/son.length/50):0;
  const v5=s.klines.slice(-5).reduce((a,x)=>a+x.volume,0)/5;
  const v20=s.klines.slice(-20).reduce((a,x)=>a+x.volume,0)/20+1e-9;
  const hacim=Math.tanh(v5/v20-1);
  const btcTrend=multiAgent.btcTrendGucu();
  return [rsi,trend,vol,sapma,mom,pos,wr,sonGetiri,hacim,btcTrend];
}

/* ============ KARAR MOTORU ============ */
function filtreMetniHesap(f){return [f.name,f.condition,f.type,f.id,f.rule,f.action,f.description,f.kural,f.kosul,f.ad,f.tanim].filter(Boolean).join(' ').toLowerCase();}
function filtreMetni(f){if(!f._metni) f._metni=filtreMetniHesap(f); return f._metni;}
function filtreDegerlendir(f,v,kr){
  const t=filtreMetni(f);
  if(/saat|hour|gece|time|zaman/.test(t)){
    const s=new Date().getHours();
    if(/02.*06|gece.*02/.test(t)&&s>=2&&s<6) return {gecti:false,sebep:`Yasak saat`,tur:'zaman'};
  }
  if(/rsi/.test(t)){
    if(v.rsi==null) return {gecti:true,sebep:'',tur:'rsi'};
    if(/aşırı.*al|overbought|>70/.test(t)&&v.rsi>(kr?.rsiSat??70)) return {gecti:false,sebep:`RSI aşırı alım`,tur:'rsi'};
    if(/aşırı.*sat|oversold|30 alt/.test(t)&&v.rsi<(kr?.rsiAl??30)) return {gecti:true,sebep:`RSI fırsat`,tur:'rsi'};
  }
  if(/atr|volatil/.test(t)){
    if(v.atr&&v.fiyat){const y=(v.atr/v.fiyat)*100; const mx=kr?.atrMax??5;
      if(/yüksek|high/.test(t)&&y>mx) return {gecti:false,sebep:`Yüksek volatilite`,tur:'atr'};}
  }
  if(/likidite|liquidity|depth/.test(t)){
    if(v.orderbook){const t2=v.orderbook.bidLiquidity+v.orderbook.askLiquidity; const mn=kr?.likiditeMin??1_000_000;
      if(t2<mn) return {gecti:false,sebep:`Düşük likidite`,tur:'likidite'};}
  }
  if(/spread/.test(t)){
    if(v.orderbook){const y=(v.orderbook.spread/v.orderbook.midPrice)*100; const mx=kr?.spreadMax??0.05;
      if(y>mx) return {gecti:false,sebep:`Yüksek spread`,tur:'spread'};}
  }
  if(/ardışık|ust uste|üst üste|streak|seri/.test(t)){
    if(state.portfolio.kaybeden>=3) return {gecti:false,sebep:'Ardışık 3+ zarar',tur:'seri'};
  }
  return {gecti:true,sebep:'',tur:'genel'};
}
function kararMotoru(sym,v){
  const kr=genetik.enIyi,s=state.symbols[sym];
  const aktifFiltreler=[];
  for(const f of state.riskFilters){
    const r=filtreDegerlendir(f,v,kr);
    if(!r.gecti) return {karar:'BEKLE',sebep:`RİSK: ${r.sebep}`,aktifFiltreler};
    aktifFiltreler.push(f);
  }
  let alA=0,satA=0;
  for(const f of state.karFilters){
    const r=filtreDegerlendir(f,v,kr);
    const t=filtreMetni(f);
    const a=ogrenme.agirlikAl(f);
    if(r.gecti){
      if(/al|buy|long|yüksel|yuksel/.test(t)) alA+=a;
      if(/sat|sell|short|düş|dus/.test(t)) satA+=a;
      aktifFiltreler.push(f);
    }
  }
  const rsiAl=kr?.rsiAl??35,rsiSat=kr?.rsiSat??65,emaK=kr?.emaKisa??20,emaU=kr?.emaUzun??50;
  const series=seriesAl(sym);
  let teknik='BEKLE';
  if(series&&v.rsi!=null){
    const eK=series.emaKisa[emaK]?.[series.emaKisa[emaK].length-1];
    const eU=series.emaUzun[emaU]?.[series.emaUzun[emaU].length-1];
    if(eK!=null&&eU!=null){
      if(v.rsi<rsiAl&&eK>eU) teknik='AL';
      else if(v.rsi>rsiSat&&eK<eU) teknik='SAT';
      else if(v.rsi<rsiAl*0.85) teknik='AL';
      else if(v.rsi>rsiSat*1.15) teknik='SAT';
    }
  }
  let aiKatki=0,aiSebep='';
  if(s.aiTahmin!=null){
    const g=s.aiConf;
    if(g>0.6){if(s.aiTahmin>0.5){aiKatki=1.2*g; aiSebep=`AI↑`;} else {aiKatki=-1.2*g; aiSebep=`AI↓`;}}
  }
  const alSkor=alA+(teknik==='AL'?1.5:0)+Math.max(0,aiKatki);
  const satSkor=satA+(teknik==='SAT'?1.5:0)+Math.max(0,-aiKatki);
  if(alSkor>satSkor&&alSkor>0.8) return {karar:'AL',sebep:`AlSkor ${alSkor.toFixed(2)} ${aiSebep}`,aktifFiltreler};
  if(satSkor>alSkor&&satSkor>0.8) return {karar:'SAT',sebep:`SatSkor ${satSkor.toFixed(2)} ${aiSebep}`,aktifFiltreler};
  if(teknik!=='BEKLE') return {karar:teknik,sebep:`Teknik ${aiSebep}`,aktifFiltreler};
  return {karar:'BEKLE',sebep:aiSebep||'Sinyal yok',aktifFiltreler};
}

/* ============ POZİSYON AÇ ============ */
function pozisyonAc(sym,yon,fiyat,sebep,aktifFiltreler){
  const s=state.symbols[sym];
  if(s.position) return;
  if(state.portfolio.bakiye<50) return;
  const kr=genetik.enIyi;
  const baseRisk=kr?.riskPct??0.02;
  // V9: ATR bazlı dinamik SL/TP
  let atrPct=0.01;
  try{
    const series=seriesAl(sym);
    if(series && series.atr && series.atr[series.atr.length-1] && series.closes){
      const lastClose=series.closes[series.closes.length-1]||fiyat;
      atrPct=(series.atr[series.atr.length-1]/lastClose)||0.01;
    } else if(s.indicators.atr && fiyat){
      atrPct=(s.indicators.atr/fiyat)||0.01;
    }
  }catch(e){}
  atrPct=Math.max(0.003, Math.min(0.05, atrPct));
  let action=2;
  const sid=qlearning.stateHesapla(sym);
  const st=surekliStateCikar(sym);
  const mtf=mtfStateCikar(sym);
  const seq=seqCikar(sym);

  if(aktifModel==='qtable'){
    action=qlearning.actionSec(sid);
    s.sonStateVec=null; s.sonAction=action;
    qlearning.islemBaslat(sym,action,sid);
  } else if(aktifModel==='dqn'){
    if(!s.dqn) s.dqn=new DQN(sym);
    if(st){action=s.dqn.actionSec(st); s.sonStateVec=st; s.sonAction=action;}
  } else if(aktifModel==='policy'){
    if(!s.pg) s.pg=new PolicyGradient(sym);
    if(st){action=s.pg.actionSec(st); s.sonStateVec=st; s.sonAction=action; s.pg.storeStep(st,action,0);}
  } else if(aktifModel==='ppo'){
    if(!s.ppo) s.ppo=new PPO(sym);
    if(st){action=s.ppo.actionSec(st); s.sonStateVec=st; s.sonAction=action; s.ppo.storeStep(st,action,0);}
  } else if(aktifModel==='a2c'){
    if(!s.a2c) s.a2c=new A2C(sym);
    if(st){action=s.a2c.actionSec(st); s.sonStateVec=st; s.sonAction=action; s.a2c.storeStep(st,action,0);}
  } else if(aktifModel==='transformer'){
    if(!s.transformer) s.transformer=new Transformer(sym);
    if(seq){action=s.transformer.actionSec(seq); s.sonStateVec=seq; s.sonAction=action; s.transformer.storeStep(seq,action,0);}
  } else if(aktifModel==='maml'){
    if(!s.maml) s.maml=new MAML(sym);
    if(mtf){const td=mamlTaskData(sym); action=s.maml.actionSec(mtf,td); s.sonStateVec=mtf; s.sonAction=action;}
  } else if(aktifModel==='ensemble'){
    const vote=ensemble.oyVer(sym);
    action=vote.action;
    s.ensembleVote=vote;
    s.sonStateVec=vote.st;
    s.sonAction=action;
    if(st&&s.ppo) s.ppo.storeStep(st,action,0);
    if(st&&s.a2c) s.a2c.storeStep(st,action,0);
    if(seq&&s.transformer) s.transformer.storeStep(seq,action,0);
    gosterVotePanel(sym,vote);
  }

  const riskCarpan=qlearning.actionRiskCarpan(action);
  const modelEtiket=aktifModel==='ensemble'?'ENS'
    :aktifModel==='dqn'?'DQN':aktifModel==='ppo'?'PPO'
    :aktifModel==='a2c'?'A2C':aktifModel==='transformer'?'TRF'
    :aktifModel==='maml'?'MAML':aktifModel==='policy'?'PG':'Q';
  const logCls=aktifModel==='ensemble'?'ens'
    :aktifModel==='ppo'?'ppo':aktifModel==='dqn'?'dqn'
    :aktifModel==='a2c'?'a2c':aktifModel==='transformer'?'trans'
    :aktifModel==='maml'?'maml':aktifModel==='policy'?'pg':'q';

  if(action===0){
    logYaz(`[${S_INFO[sym].short}] 🎛️ ${modelEtiket} → atla`,logCls);
    if(aktifModel==='ensemble'&&s.ensembleVote){ensemble.sonucGuncelle(s.ensembleVote,false,0); s.ensembleVote=null;}
    return;
  }

  let konsensusBonus=1.0;
  const kons=multiAgent.konsensus();
  if(kons.yon!==0&&aktifModel!=='qtable'){
    const tradeYonu=yon==='AL'?1:-1;
    if(kons.yon===tradeYonu){konsensusBonus=1+0.3*kons.guc; logYaz(`🤝 MA konsensüs [${kons.detay}] → ×${konsensusBonus.toFixed(2)}`,'ma');}
    else{konsensusBonus=0.7; logYaz(`⚠️ MA ters [${kons.detay}] → ×0.70`,'ma');}
  }

  let ensembleBonus=1.0;
  if(aktifModel==='ensemble'&&s.ensembleVote){
    const n=s.ensembleVote.votes.length;
    if(s.ensembleVote.agree===n) ensembleBonus=1.25;
    else if(s.ensembleVote.agree===n-1) ensembleBonus=1.10;
    else if(s.ensembleVote.agree===n-2) ensembleBonus=1.00;
    else ensembleBonus=0.85;
  }

  const riskY=baseRisk*riskCarpan*konsensusBonus*ensembleBonus;
  let miktarTL=state.portfolio.bakiye*riskY;
  if(miktarTL<10) return;
  // V9 Fee + Slippage reserve
  const feeOpen=miktarTL*FEE_RATE;
  const slipOpen=miktarTL*SLIPPAGE_RATE;
  if(miktarTL+feeOpen+slipOpen > state.portfolio.bakiye*0.95) miktarTL=state.portfolio.bakiye*0.95 - feeOpen - slipOpen;
  const miktar=miktarTL/fiyat;
  const stopY=Math.max(0.005, atrPct*ATR_SL_MULT);
  const karY=Math.max(0.008, atrPct*ATR_TP_MULT);

  s.position={
    sym,yon,girisFiyat:fiyat,miktar,
    stop:yon==='AL'?fiyat*(1-stopY):fiyat*(1+stopY),
    hedef:yon==='AL'?fiyat*(1+karY):fiyat*(1-karY),
    stopY,karY,atrPct,
    feeOpen,slipOpen,
    acilisZaman:Date.now(),sebep,filtreler:aktifFiltreler||[],
    qAction:action,qStateId:sid,miktarTL,miktarTLNet:miktarTL-feeOpen-slipOpen,
    rlState:s.sonStateVec,mtfState:mtf,rlAction:action,rlModel:aktifModel,
    ensembleVote:s.ensembleVote?JSON.parse(JSON.stringify({
      action:s.ensembleVote.action,agree:s.ensembleVote.agree,conf:s.ensembleVote.conf,
      votes:s.ensembleVote.votes.map(v=>({model:v.model,action:v.action,w:v.w}))
    })):null
  };
  state.portfolio.bakiye-=(miktarTL+feeOpen+slipOpen);
  state.portfolio.toplamFee=(state.portfolio.toplamFee||0)+feeOpen+slipOpen;

  const ensStr=aktifModel==='ensemble'&&s.ensembleVote
    ?` [ENS:${s.ensembleVote.agree}/6 oy ×${ensembleBonus.toFixed(2)}]`:'';
  logYaz(
    `🟢 [${S_INFO[sym].short}] ${yon} ${miktar.toFixed(6)} @ $${fmt(fiyat)} | Risk %${(riskY*100).toFixed(2)} [${modelEtiket}:${qlearning.actionAdi(action)}]${ensStr} ${sebep}`,
    yon==='AL'?'trade-buy':'trade-sell'
  );
}

/* ============ POZİSYON KAPAT ============ */
function pozisyonKapat(sym,fiyat,sebep){
  const s=state.symbols[sym];
  const p=s.position;
  if(!p) return;
  const feeClose=p.miktar*fiyat*FEE_RATE;
  const slipClose=p.miktar*fiyat*SLIPPAGE_RATE;
  const gross=p.yon==='AL'?(fiyat-p.girisFiyat)*p.miktar:(p.girisFiyat-fiyat)*p.miktar;
  const g=gross - feeClose - slipClose - (p.feeOpen||0) - (p.slipOpen||0);
  // Bakiye: açıkken düşmüştük, şimdi giriş sermayesi + net kar iade
  state.portfolio.bakiye+=p.miktar*p.girisFiyat+gross - feeClose - slipClose;
  state.portfolio.toplamFee=(state.portfolio.toplamFee||0)+feeClose+slipClose;
  state.portfolio.toplamKar+=g;
  state.portfolio.toplamIslem++;
  const kz=g>=0;
  if(kz) state.portfolio.kazanan++; else state.portfolio.kaybeden++;
  const getiriYuzde=p.miktarTL>0?(g/p.miktarTL)*100:0;
  // V9 reward: fee-aware + Sharpe benzeri
  const reward=getiriYuzde*10 - (feeClose+slipClose)/Math.max(1,p.miktarTL)*100;

  ogrenme.ogren(p.filtreler,kz,g);
  const model=p.rlModel||aktifModel;

  if(model==='qtable'||model==='ensemble'){
    if(model==='ensemble') qlearning.sonState[sym]={sid:p.qStateId,action:p.rlAction,ts:Date.now()};
    qlearning.ogren(sym,getiriYuzde);
  }
  if((model==='dqn'||model==='ensemble')&&s.dqn&&p.rlState){
    const s2=surekliStateCikar(sym)||p.rlState;
    const exp={s:p.rlState,a:p.rlAction,r:reward,s2,d:true};
    s.dqn.store(p.rlState,p.rlAction,reward,s2,true,Math.abs(reward));
    multiAgent.bufferEkle(exp);
    s.dqn.train(multiAgent.sharedBuffer);
  }
  if((model==='ppo'||model==='ensemble')&&s.ppo){
    const tr=s.ppo.trajectory;
    if(tr.length>0) tr[tr.length-1].r=reward;
    s.ppo.finishEpisode();
  }
  if((model==='a2c'||model==='ensemble')&&s.a2c){
    const tr=s.a2c.trajectory;
    if(tr.length>0) tr[tr.length-1].r=reward;
    s.a2c.finishEpisode();
  }
  if((model==='transformer'||model==='ensemble')&&s.transformer){
    const tr=s.transformer.trajectory;
    if(tr.length>0) tr[tr.length-1].r=reward;
    s.transformer.finishEpisode();
  }
  if((model==='maml'||model==='ensemble')&&s.maml){
    // MAML: her kapanışta adapt
    const td=mamlTaskData(sym);
    if(td.length>0) s.maml.adapt(td);
  }
  if(model==='policy'&&s.pg){
    const tr=s.pg.trajectory;
    if(tr.length>0) tr[tr.length-1].r=reward;
    s.pg.finishEpisode();
  }
  if(model==='ensemble'&&p.ensembleVote){
    ensemble.sonucGuncelle(p.ensembleVote,kz,reward);
    s.ensembleVote=null;
  }

  state.portfolio.islemGecmisi.push({...p,cikisFiyat:fiyat,getiri:g,getiriYuzde,sebep,kapanisZaman:Date.now()});
  if(state.portfolio.islemGecmisi.length>200) state.portfolio.islemGecmisi.shift();

  const tur=kz?'basari':'hata';
  const ik=kz?'✅':'❌';
  logYaz(`${ik} [${S_INFO[sym].short}] ${p.yon} kapandı @ $${fmt(fiyat)} | K/Z: $${fmt(g)} (%${getiriYuzde.toFixed(2)}) fee:$${fmt((p.feeOpen||0)+feeClose)} [${model}] ATR:${(p.atrPct*100).toFixed(2)}% SL:${(p.stopY*100).toFixed(2)}% TP:${(p.karY*100).toFixed(2)}% | ${sebep}`,tur);
  s.position=null;
  s.sonStateVec=null; s.sonAction=null;
  if(state.portfolio.toplamIslem%5===0){
    aiKaydet(); dqnKaydet(); pgKaydet(); ppoKaydet(); a2cKaydet(); trfKaydet(); mamlKaydet(); ensemble.kaydet();
  }
}
function pozisyonKontrol(sym,fiyat){
  const s=state.symbols[sym];
  const p=s.position;
  if(!p) return;
  if(p.yon==='AL'){
    if(fiyat<=p.stop) pozisyonKapat(sym,fiyat,'STOP-LOSS');
    else if(fiyat>=p.hedef) pozisyonKapat(sym,fiyat,'TAKE-PROFIT');
  } else {
    if(fiyat>=p.stop) pozisyonKapat(sym,fiyat,'STOP-LOSS');
    else if(fiyat<=p.hedef) pozisyonKapat(sym,fiyat,'TAKE-PROFIT');
  }
}

/* ============ KAYIT-YÜKLEME ============ */
